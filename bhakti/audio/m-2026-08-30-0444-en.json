[{"i":0,"text":"We don't need to imagine that ourselves.","startMs":2982,"endMs":4758},{"i":1,"text":"Its fruit was told by Sage Agastya himself to Sri Rama.","startMs":4978,"endMs":7666},{"i":2,"text":"Adityahrudayam punyam","startMs":8346,"endMs":9426},{"i":3,"text":"Sarvashatruvinashanam |","startMs":9846,"endMs":11430},{"i":4,"text":"Jayavaham japennityam","startMs":11850,"endMs":13194},{"i":5,"text":"Akshayam paramam shivam ||","startMs":13614,"endMs":14886},{"i":6,"text":"Sarvamangalamangalyam","startMs":15566,"endMs":16910},{"i":7,"text":"Sarvapapapranashanam |","startMs":17330,"endMs":18602},{"i":8,"text":"Chintashokaprashamanam","startMs":19022,"endMs":20486},{"i":9,"text":"Ayurvardhanamuttamam ||","startMs":20906,"endMs":21914},{"i":10,"text":"This means Aditya Hrudayam—","startMs":22594,"endMs":24130},{"i":11,"text":"grants victory.","startMs":24810,"endMs":25626},{"i":12,"text":"pacifies worry and sorrow.","startMs":26046,"endMs":27510},{"i":13,"text":"brings auspiciousness.","startMs":27930,"endMs":29202},{"i":14,"text":"is said to increase lifespan.","startMs":29622,"endMs":31206},{"i":15,"text":"Not only that… Sage Agastya told Rama another very important thing:","startMs":31886,"endMs":35774},{"i":16,"text":"Enamapatsu kruchchhreshu","startMs":36454,"endMs":37726},{"i":17,"text":"Kantarayshu bhayeshu cha |","startMs":38146,"endMs":39298},{"i":18,"text":"Keertayan purushah kashchin","startMs":39718,"endMs":41062},{"i":19,"text":"Navaseedati Raghava ||","startMs":41482,"endMs":42634},{"i":20,"text":"Meaning—","startMs":43314,"endMs":43746},{"i":21,"text":"In dangers...","startMs":44426,"endMs":45314},{"i":22,"text":"In difficulties...","startMs":45734,"endMs":46886},{"i":23,"text":"In fearful situations...","startMs":47306,"endMs":48650},{"i":24,"text":"The person who remembers Adityudu (the Sun God) will not lose courage.","startMs":49070,"endMs":53102},{"i":25,"text":"This feels even more beautiful because...","startMs":53782,"endMs":55822},{"i":26,"text":"To Rama, who was tired on the battlefield, standing and seeing Ravana in front of him,","startMs":56502,"endMs":60774},{"i":27,"text":"Sage Agastya did not give a new weapon.","startMs":61194,"endMs":63618},{"i":28,"text":"He taught Aditya Hrudayam.","startMs":64038,"endMs":65574},{"i":29,"text":"☀️","startMs":65794,"endMs":65794},{"i":30,"text":"That is why Aditya Hrudayam is not just a stotram recited for victory...","startMs":66474,"endMs":70050},{"i":31,"text":"so that one doesn't crumble when difficulty comes,","startMs":70730,"endMs":73226},{"i":32,"text":"so that one stands firm when fear comes,","startMs":73646,"endMs":75758},{"i":33,"text":"a prayer that reminds us of our courage even amidst worry.","startMs":76178,"endMs":78866},{"i":34,"text":"☀️❤️","startMs":79086,"endMs":79086},{"i":35,"text":"🙏 Om Adityaya Namaha","startMs":79766,"endMs":81038}]