[{"i":0,"text":"Sharannavaratrulu — Sixth Day","startMs":2334,"endMs":4182},{"i":1,"text":"1. Praise of the Mother Goddess in the form of Shakti","startMs":4862,"endMs":8126},{"i":2,"text":"Ya Devi sarvabhuteshu shaktirupena samsthita |","startMs":8806,"endMs":12454},{"i":3,"text":"Namastasyai namastasyai namastasyai namo namah ||","startMs":12874,"endMs":16138},{"i":4,"text":"Meaning:","startMs":16818,"endMs":17322},{"i":5,"text":"I repeatedly bow to the Mother Goddess who resides in all beings in the form of Shakti.","startMs":18002,"endMs":22034},{"i":6,"text":"Praise of the form of Shakti from Devi Mahatmyam.","startMs":22714,"endMs":25138},{"i":7,"text":"2. Katyayani Prayer","startMs":25818,"endMs":27666},{"i":8,"text":"Chandrahāsojjvalakarā shārdūlavaravāhanā |","startMs":28346,"endMs":30698},{"i":9,"text":"Kātyāyanī shubham dadyāddevī dānavaghātinī ||","startMs":31118,"endMs":33926},{"i":10,"text":"Meaning:","startMs":34606,"endMs":35038},{"i":11,"text":"May Mother Katyayani, who holds a hand adorned with the sword called Chandrahasa, has a tiger as her vehicle, and slays demons, bestow auspiciousness upon us.","startMs":35718,"endMs":44550},{"i":12,"text":"Prayer from Sri Navadurga Stotram.","startMs":45230,"endMs":46958},{"i":13,"text":"Nāma Mantra","startMs":47638,"endMs":48406},{"i":14,"text":"Om Devi Kātyāyanyai Namah ||","startMs":49086,"endMs":50862},{"i":15,"text":"Pocket Panchangam · Sanatana Jnanam","startMs":51542,"endMs":53582}]