[{"i":0,"text":"1. Brahmacharini Stuti","startMs":4326,"endMs":5862},{"i":1,"text":"Ya Devi Sarvabhuteshu Brahmacharini Rupena Samsthita.","startMs":6542,"endMs":9926},{"i":2,"text":"Namastasyai Namastasyai Namastasyai Namo Namah.","startMs":10346,"endMs":13154},{"i":3,"text":"Meaning:","startMs":13834,"endMs":14266},{"i":4,"text":"I repeatedly prostrate to the Mother who resides in all beings in the form of Brahmacharini.","startMs":14946,"endMs":19098},{"i":5,"text":"2. Dhyana Shlokam","startMs":19778,"endMs":21434},{"i":6,"text":"Dadhaana Karapadmabhyaamakshamaalaakamandaloo.","startMs":22114,"endMs":24802},{"i":7,"text":"Devi Praseedatu Mayi Brahmacharinyanuttamaa.","startMs":25222,"endMs":27718},{"i":8,"text":"Meaning:","startMs":28398,"endMs":28830},{"i":9,"text":"I pray that the peerless Sri Brahmacharini Mother, who holds a rosary and a water pot in her two lotus-like hands, may shower her grace upon me.","startMs":29510,"endMs":36470},{"i":10,"text":"Om Devi Brahmacharinyai Namah.","startMs":37150,"endMs":38686},{"i":11,"text":"Pocket Panchangam · Sanatana Jnanam","startMs":39366,"endMs":41094}]