[{"i":0,"text":"Everyone else…","startMs":3102,"endMs":4062},{"i":1,"text":"Had a place beside Rama.","startMs":4482,"endMs":5562},{"i":2,"text":"Hanuman chose…","startMs":6242,"endMs":7250},{"i":3,"text":"Rama’s feet.","startMs":7670,"endMs":8438},{"i":4,"text":"Because closeness…","startMs":9118,"endMs":10198},{"i":5,"text":"Isn’t measured by position.","startMs":10618,"endMs":12082},{"i":6,"text":"It’s measured…","startMs":12762,"endMs":13722},{"i":7,"text":"By surrender.","startMs":14142,"endMs":14958},{"i":8,"text":"The world competes…","startMs":15638,"endMs":17030},{"i":9,"text":"To stand beside greatness.","startMs":17450,"endMs":18986},{"i":10,"text":"Hanuman chose…","startMs":19666,"endMs":20674},{"i":11,"text":"Rama’s feet.","startMs":21094,"endMs":21910},{"i":12,"text":"And in doing so…","startMs":22590,"endMs":23550},{"i":13,"text":"Became the foundation…","startMs":23970,"endMs":25314},{"i":14,"text":"On which greatness can stand.","startMs":25734,"endMs":27078},{"i":15,"text":"Jai Shri Ram 🏹♥️","startMs":27758,"endMs":28718},{"i":16,"text":"Om Hanumathe Namaha ⛳️🧡","startMs":29138,"endMs":30146}]