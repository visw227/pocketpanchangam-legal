[{"i":0,"text":"Everyone else…","startMs":3102,"endMs":3990},{"i":1,"text":"Had a place beside Rama.","startMs":4410,"endMs":5682},{"i":2,"text":"Hanuman chose…","startMs":6362,"endMs":7322},{"i":3,"text":"Rama’s feet.","startMs":7742,"endMs":8438},{"i":4,"text":"Because closeness…","startMs":9118,"endMs":10198},{"i":5,"text":"Isn’t measured by position.","startMs":10618,"endMs":11890},{"i":6,"text":"It’s measured…","startMs":12570,"endMs":13338},{"i":7,"text":"By surrender.","startMs":13758,"endMs":14574},{"i":8,"text":"The world competes…","startMs":15254,"endMs":16646},{"i":9,"text":"To stand beside greatness.","startMs":17066,"endMs":18602},{"i":10,"text":"Hanuman chose…","startMs":19282,"endMs":20362},{"i":11,"text":"Rama’s feet.","startMs":20782,"endMs":21598},{"i":12,"text":"And in doing so…","startMs":22278,"endMs":23286},{"i":13,"text":"Became the foundation…","startMs":23706,"endMs":24714},{"i":14,"text":"On which greatness can stand.","startMs":25134,"endMs":26478},{"i":15,"text":"Jai Shri Ram 🏹♥️","startMs":27158,"endMs":27926},{"i":16,"text":"Om Hanumathe Namaha ⛳️🧡","startMs":28346,"endMs":29498}]