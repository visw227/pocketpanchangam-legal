[{"i":0,"text":"Just observe once.","startMs":6174,"endMs":7254},{"i":1,"text":"With Shiva, there is Nandi.","startMs":7934,"endMs":9710},{"i":2,"text":"With Goddess Parvati, there is a lion.","startMs":10130,"endMs":11786},{"i":3,"text":"With Vinayaka, there is a mouse.","startMs":12206,"endMs":14054},{"i":4,"text":"With Kumaraswamy, there is a peacock.","startMs":14474,"endMs":16250},{"i":5,"text":"Around Shiva's neck, there is a snake.","startMs":16670,"endMs":18974},{"i":6,"text":"If you look in nature,","startMs":19654,"endMs":20662},{"i":7,"text":"the bull and the lion;","startMs":21082,"endMs":21970},{"i":8,"text":"the peacock and the snake;","startMs":22390,"endMs":23662},{"i":9,"text":"these are natures that seem entirely different from one another,","startMs":24082,"endMs":26962},{"i":10,"text":"sometimes completely opposing.","startMs":27382,"endMs":28918},{"i":11,"text":"Yet in Kailasa,","startMs":29598,"endMs":30558},{"i":12,"text":"all of them live together peacefully in one place.","startMs":30978,"endMs":33210},{"i":13,"text":"❤️","startMs":33430,"endMs":33430},{"i":14,"text":"Perhaps,","startMs":34110,"endMs":34686},{"i":15,"text":"Shiva's family reminds us of a beautiful truth—","startMs":35106,"endMs":37530},{"i":16,"text":"Peace does not mean","startMs":38210,"endMs":39290},{"i":17,"text":"everyone being the same.","startMs":39710,"endMs":40910},{"i":18,"text":"It is being able to live together harmoniously","startMs":41590,"endMs":44278},{"i":19,"text":"even amidst differences.","startMs":44698,"endMs":46042},{"i":20,"text":"Making coexistence possible","startMs":46462,"endMs":48046},{"i":21,"text":"even amidst opposing natures.","startMs":48466,"endMs":50122},{"i":22,"text":"Isn't that what it means for divinity to dwell","startMs":50802,"endMs":52914},{"i":23,"text":"where people respect and accept one another!","startMs":53334,"endMs":55374},{"i":24,"text":"Even opposing natures being able to stay together.","startMs":55794,"endMs":58146},{"i":25,"text":"❤️","startMs":58366,"endMs":58366},{"i":26,"text":"Hara Hara Mahadeva ❤️","startMs":59046,"endMs":60390}]