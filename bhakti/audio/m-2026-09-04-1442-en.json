[{"i":0,"text":"Do you know what happened in that darkness at midnight?","startMs":2910,"endMs":5262},{"i":1,"text":"This Janmashtami night, let's remember that beautiful story.","startMs":5482,"endMs":8866},{"i":2,"text":"🪷","startMs":9086,"endMs":9086},{"i":3,"text":"In Mathura, that entire night was dark.","startMs":9766,"endMs":11926},{"i":4,"text":"The prison doors were closed.","startMs":12346,"endMs":13498},{"i":5,"text":"Devaki and Vasudeva were in bondage.","startMs":13918,"endMs":16462},{"i":6,"text":"But as midnight approached,","startMs":17142,"endMs":18486},{"i":7,"text":"a divine light appeared in that darkness.","startMs":18906,"endMs":21018},{"i":8,"text":"Lord Krishna incarnated.","startMs":21698,"endMs":23234},{"i":9,"text":"🪷","startMs":23454,"endMs":23454},{"i":10,"text":"Along with that little child,","startMs":24134,"endMs":25406},{"i":11,"text":"a great message also came to the world —","startMs":25826,"endMs":27866},{"i":12,"text":"no matter how deep the darkness,","startMs":28286,"endMs":30014},{"i":13,"text":"it only takes a moment for light to appear.","startMs":30434,"endMs":32402},{"i":14,"text":"💙","startMs":32622,"endMs":32622},{"i":15,"text":"This sacred night,","startMs":33302,"endMs":34262},{"i":16,"text":"let's invite that child Krishna into our homes, into our hearts.","startMs":34682,"endMs":38138},{"i":17,"text":"🙏","startMs":38358,"endMs":38358},{"i":18,"text":"Om Namo Bhagavate Vasudevaya ॥","startMs":39038,"endMs":40622}]