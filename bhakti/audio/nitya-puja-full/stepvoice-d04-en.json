[{"i":0,"text":"Surya Bhagavan is the deity we can see with our own eyes every single day.","startMs":1566,"endMs":5214},{"i":1,"text":"For a few moments this morning, remember with devotion the Sun who gives the world its light, energy and life.","startMs":5434,"endMs":10618},{"i":2,"text":"If you can, face the east and offer namaskaram.","startMs":10838,"endMs":13262},{"i":3,"text":"ఓం మిత్రాయ నమః ॥","startMs":14696,"endMs":16634},{"i":4,"text":"ఓం రవయే నమః ॥","startMs":17114,"endMs":19172},{"i":5,"text":"ఓం సూర్యాయ నమః ॥","startMs":19652,"endMs":21518},{"i":6,"text":"ఓం భానవే నమః ॥","startMs":21998,"endMs":24056},{"i":7,"text":"ఓం ఖగాయ నమః ॥","startMs":24536,"endMs":26330},{"i":8,"text":"ఓం పూష్ణే నమః ॥","startMs":26810,"endMs":28676},{"i":9,"text":"ఓం హిరణ్యగర్భాయ నమః ॥","startMs":29156,"endMs":31526},{"i":10,"text":"ఓం మరీచయే నమః ॥","startMs":32006,"endMs":34064},{"i":11,"text":"ఓం ఆదిత్యాయ నమః ॥","startMs":34544,"endMs":37298},{"i":12,"text":"ఓం సవిత్రే నమః ॥","startMs":37778,"endMs":39836},{"i":13,"text":"ఓం అర్కాయ నమః ॥","startMs":40316,"endMs":42254},{"i":14,"text":"ఓం భాస్కరాయ నమః ॥","startMs":42734,"endMs":45056}]