[{"i":0,"text":"Surya Bhagavan is the deity we can see with our own eyes every single day.","startMs":1566,"endMs":5982},{"i":1,"text":"For a few moments this morning, remember with devotion the Sun who gives the world its light, energy and life.","startMs":6202,"endMs":11962},{"i":2,"text":"If you can, face the east and offer namaskaram.","startMs":12182,"endMs":14414},{"i":3,"text":"ఓం మిత్రాయ నమః ॥","startMs":15848,"endMs":18362},{"i":4,"text":"ఓం రవయే నమః ॥","startMs":18842,"endMs":20900},{"i":5,"text":"ఓం సూర్యాయ నమః ॥","startMs":21380,"endMs":23246},{"i":6,"text":"ఓం భానవే నమః ॥","startMs":23726,"endMs":25520},{"i":7,"text":"ఓం ఖగాయ నమః ॥","startMs":26000,"endMs":27794},{"i":8,"text":"ఓం పూష్ణే నమః ॥","startMs":28274,"endMs":30140},{"i":9,"text":"ఓం హిరణ్యగర్భాయ నమః ॥","startMs":30620,"endMs":32942},{"i":10,"text":"ఓం మరీచయే నమః ॥","startMs":33422,"endMs":35552},{"i":11,"text":"ఓం ఆదిత్యాయ నమః ॥","startMs":36032,"endMs":38786},{"i":12,"text":"ఓం సవిత్రే నమః ॥","startMs":39266,"endMs":41396},{"i":13,"text":"ఓం అర్కాయ నమః ॥","startMs":41876,"endMs":43814},{"i":14,"text":"ఓం భాస్కరాయ నమః ॥","startMs":44294,"endMs":46472}]