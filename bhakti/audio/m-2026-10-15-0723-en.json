[{"i":0,"text":"Sharannavaratrulu — Fifth Day","startMs":2334,"endMs":3918},{"i":1,"text":"1. Praise of the Mother Form of the Goddess","startMs":4598,"endMs":7214},{"i":2,"text":"Ya Devi Sarvabhuteshu Matruroopena Samsthita |","startMs":7894,"endMs":10582},{"i":3,"text":"Namastasyai Namastasyai Namastasyai Namo Namah ||","startMs":11002,"endMs":13930},{"i":4,"text":"Meaning:","startMs":14610,"endMs":15042},{"i":5,"text":"I repeatedly bow to the Goddess who is present in all beings in the form of a mother.","startMs":15722,"endMs":19802},{"i":6,"text":"Praise of the mother form from Devi Mahatmyam.","startMs":20482,"endMs":22594},{"i":7,"text":"2. Skandamata Prayer","startMs":23274,"endMs":24282},{"i":8,"text":"Simhasanagata Nityam Padmashritakaradvaya |","startMs":24962,"endMs":27314},{"i":9,"text":"Shubhadastu Sada Devi Skandamata Yashasvini ||","startMs":27734,"endMs":30158},{"i":10,"text":"Meaning:","startMs":30838,"endMs":31270},{"i":11,"text":"May the glorious Goddess Skandamata, seated on a lion-throne and holding lotuses in both hands, always bestow auspiciousness.","startMs":31950,"endMs":38790},{"i":12,"text":"Prayer from Sri Navadurga Stotram.","startMs":39470,"endMs":41198},{"i":13,"text":"Name Mantra","startMs":41878,"endMs":42574},{"i":14,"text":"Om Devi Skandamatryai Namah ||","startMs":43254,"endMs":44838},{"i":15,"text":"Pocket Panchangam · Sanatana Gnanam","startMs":45518,"endMs":47558}]