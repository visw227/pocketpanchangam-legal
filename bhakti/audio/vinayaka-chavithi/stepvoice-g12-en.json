[{"i":0,"text":"Offer Vinayaka whatever naivedyam you were able to make.","startMs":1638,"endMs":4446},{"i":1,"text":"Then offer a little water.","startMs":4666,"endMs":5938},{"i":2,"text":"ఓం గం గణపతయే నమః ।","startMs":7376,"endMs":9386},{"i":3,"text":"నైవేద్యం సమర్పయామి ॥","startMs":9866,"endMs":12170}]