[{"i":0,"text":"Take a little water in your right hand, and sip a little after each mantra.","startMs":1326,"endMs":5214},{"i":1,"text":"ఓం కేశవాయ స్వాహా ।","startMs":6656,"endMs":8786},{"i":2,"text":"ఓం నారాయణాయ స్వాహా ।","startMs":9266,"endMs":11324},{"i":3,"text":"ఓం మాధవాయ స్వాహా ।","startMs":11804,"endMs":13670}]