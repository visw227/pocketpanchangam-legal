[{"i":0,"text":"1. Brahmacharini Hymn of Praise","startMs":4398,"endMs":6510},{"i":1,"text":"Ya Devi Sarvabhuteshu Brahmacharini Rupena Samsthita.","startMs":7190,"endMs":10310},{"i":2,"text":"Namastasyai Namastasyai Namastasyai Namo Namah.","startMs":10730,"endMs":13658},{"i":3,"text":"Meaning:","startMs":14338,"endMs":14770},{"i":4,"text":"I repeatedly prostrate to the Mother Goddess, who resides in all beings in the form of Brahmacharini.","startMs":15450,"endMs":20634},{"i":5,"text":"2. Meditation Verse","startMs":21314,"endMs":22970},{"i":6,"text":"Dadana Karapadmabhyamakshamalakamanalu.","startMs":23650,"endMs":26002},{"i":7,"text":"Devi Prasidatu Mayi Brahmacharinyanuttama.","startMs":26422,"endMs":28918},{"i":8,"text":"Meaning:","startMs":29598,"endMs":30030},{"i":9,"text":"I pray that the incomparable Sri Brahmacharini Mother Goddess, who holds a rosary and a water pot in her two lotus-like hands, may shower her grace upon me.","startMs":30710,"endMs":38702},{"i":10,"text":"Om Devi Brahmacharinyai Namah.","startMs":39382,"endMs":41110},{"i":11,"text":"Pocket Panchangam · Eternal Wisdom","startMs":41790,"endMs":43902}]