[{"i":0,"text":"mātrā-sparśās tu kaunteya śītoṣṇa-sukha-duḥkha-dāḥ","startMs":0,"endMs":4848},{"i":1,"text":"āgamāpāyino 'nityās tāṁs titikṣasva bhārata","startMs":5328,"endMs":9024},{"i":2,"text":"सर्दी-गर्मी की तरह सुख-दुख भी आते-जाते मेहमान हैं, हमेशा नहीं रहते।","startMs":9624,"endMs":13848},{"i":3,"text":"इन्हें धीरज से सह लो।","startMs":14068,"endMs":15412}]