[{"i":0,"text":"kārpaṇya-doṣopahata-svabhāvaḥ","startMs":0,"endMs":2952},{"i":1,"text":"pṛcchāmi tvāṁ dharma-sammūḍha-cetāḥ","startMs":3432,"endMs":6744},{"i":2,"text":"yac-chreyaḥ syānniścitaṁ brūhi tanme","startMs":7224,"endMs":10128},{"i":3,"text":"śiṣyaste ’haṁ śādhi māṁ tvāṁ prapannam","startMs":10608,"endMs":14472},{"i":4,"text":"Confused about my duty and overcome by weakness, I ask you: tell me decisively what is best for me.","startMs":15072,"endMs":20304},{"i":5,"text":"I am your disciple; please instruct me, as I have surrendered to you.","startMs":20524,"endMs":23980}]