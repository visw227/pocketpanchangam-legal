[{"i":0,"text":"sañjaya uvāca","startMs":0,"endMs":1104},{"i":1,"text":"etac chrutvā vacanaṁ keśavasya","startMs":1584,"endMs":3840},{"i":2,"text":"kṛtāñjalir vepamānaḥ kirīṭī","startMs":4320,"endMs":6672},{"i":3,"text":"namaskṛtvā bhūya evāha kṛṣṇaṁ","startMs":7152,"endMs":9960},{"i":4,"text":"sa-gadgadaṁ bhīta-bhītaḥ praṇamya","startMs":10440,"endMs":12936},{"i":5,"text":"संजय ने कहा: केशव के इन वचनों को सुनकर, मुकुटधारी अर्जुन ने काँपते हुए हाथ जोड़े।","startMs":13536,"endMs":19104},{"i":6,"text":"उन्होंने अत्यंत भयभीत होकर भगवान कृष्ण को प्रणाम किया और गद्गद स्वर में फिर से कहा।","startMs":19324,"endMs":23980}]