[{"i":0,"text":"ākhyāhi me ko bhavān ugra-rūpo","startMs":0,"endMs":2352},{"i":1,"text":"namo ’stu te deva-vara prasīda","startMs":2832,"endMs":5088},{"i":2,"text":"vijñātum icchāmi bhavantam ādyaṁ","startMs":5568,"endMs":8064},{"i":3,"text":"na hi prajānāmi tava pravṛttim","startMs":8544,"endMs":11400},{"i":4,"text":"Please tell me who You are in this fierce form.","startMs":12000,"endMs":13968},{"i":5,"text":"I bow to You, O supreme Lord, please be merciful.","startMs":14188,"endMs":16996},{"i":6,"text":"I want to know You, the primal Being, for I do not understand Your purpose.","startMs":17216,"endMs":20912}]