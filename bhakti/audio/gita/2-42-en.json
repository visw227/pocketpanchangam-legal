[{"i":0,"text":"yāmimāṁ puṣpitāṁ vācaṁ pravadanty-avipaścitaḥ","startMs":0,"endMs":3960},{"i":1,"text":"veda-vāda-ratāḥ pārtha nānyad astīti vādinaḥ","startMs":4440,"endMs":8856},{"i":2,"text":"kāmātmānaḥ svarga-parā janma-karma-phala-pradām","startMs":9336,"endMs":13248},{"i":3,"text":"kriyā-viśeṣa-bahulāṁ bhogaiśvarya-gatiṁ prati","startMs":13728,"endMs":17520},{"i":4,"text":"O Partha, unwise people are attracted to the flowery words of the Vedas.","startMs":18120,"endMs":22392},{"i":5,"text":"They argue that there is no higher truth beyond these rituals.","startMs":22612,"endMs":25300}]