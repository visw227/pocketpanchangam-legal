[{"i":0,"text":"yāmimāṁ puṣpitāṁ vācaṁ pravadanty-avipaścitaḥ","startMs":0,"endMs":3744},{"i":1,"text":"veda-vāda-ratāḥ pārtha nānyad astīti vādinaḥ","startMs":4224,"endMs":8040},{"i":2,"text":"kāmātmānaḥ swarga-parā janma-karma-phala-pradām","startMs":8520,"endMs":15192},{"i":3,"text":"kriyā-viśeṣa-bahulāṁ bhogaiśwarya-gatiṁ prati","startMs":15672,"endMs":26904},{"i":4,"text":"O Partha, unwise people are attracted to the flowery words of the Vedas.","startMs":27504,"endMs":31536},{"i":5,"text":"They argue that there is no higher truth beyond these rituals.","startMs":31756,"endMs":34444}]