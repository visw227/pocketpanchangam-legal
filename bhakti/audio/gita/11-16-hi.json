[{"i":0,"text":"aneka-bāhūdara-vaktra-netraṁ","startMs":0,"endMs":2208},{"i":1,"text":"paśyāmi tvāṁ sarvato ’nanta-rūpam","startMs":2688,"endMs":5736},{"i":2,"text":"nāntaṁ na madhyaṁ na punas tavādiṁ","startMs":6216,"endMs":8568},{"i":3,"text":"paśyāmi viśveśvara viśva-rūpa","startMs":9048,"endMs":11088},{"i":4,"text":"हे ब्रह्मांड के स्वामी!","startMs":11688,"endMs":12840},{"i":5,"text":"हे विश्वरूप!","startMs":13060,"endMs":13876},{"i":6,"text":"मैं आपको हर तरफ अनेक हाथों, पेटों, मुखों और आँखों वाले अनंत रूपों में देख रहा हूँ।","startMs":14096,"endMs":19784},{"i":7,"text":"मुझे आपका न तो आदि, न मध्य और न अंत दिखाई दे रहा है।","startMs":20004,"endMs":23772}]