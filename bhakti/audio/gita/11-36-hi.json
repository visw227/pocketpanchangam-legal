[{"i":0,"text":"arjuna uvāca","startMs":0,"endMs":1248},{"i":1,"text":"sthāne hṛṣīkeśa tava prakīrtyā","startMs":1728,"endMs":4080},{"i":2,"text":"jagat prahṛṣyaty anurajyate ca","startMs":4560,"endMs":7248},{"i":3,"text":"rakṣānsi bhītāni diśo dravanti","startMs":7728,"endMs":9984},{"i":4,"text":"sarve namasyanti ca siddha-saṅghāḥ","startMs":10464,"endMs":12960},{"i":5,"text":"अर्जुन ने कहा: हे ऋषिकेश, आपकी कीर्ति से सारा संसार हर्षित और अनुरक्त हो रहा है, यह बिल्कुल उचित है।","startMs":13560,"endMs":20328},{"i":6,"text":"राक्षस डरकर दिशाओं में भाग रहे हैं और सभी सिद्धगण आपको नमस्कार कर रहे हैं।","startMs":20548,"endMs":25396}]