[{"i":0,"text":"amī hi tvāṁ sura-saṅghā viśanti","startMs":0,"endMs":2256},{"i":1,"text":"kecid bhītāḥ prāñjalayo gṛṇanti","startMs":2736,"endMs":5280},{"i":2,"text":"svastīty uktvā maharṣi-siddha-saṅghāḥ","startMs":5760,"endMs":8712},{"i":3,"text":"stuvanti tvāṁ stutibhiḥ puṣkalābhiḥ","startMs":9192,"endMs":12048},{"i":4,"text":"Groups of gods are entering into You.","startMs":12648,"endMs":14424},{"i":5,"text":"Some, out of fear, are praising You with folded hands.","startMs":14644,"endMs":17452},{"i":6,"text":"Great sages and perfected souls are singing beautiful hymns, saying \"May there be peace!\"","startMs":17672,"endMs":22208}]