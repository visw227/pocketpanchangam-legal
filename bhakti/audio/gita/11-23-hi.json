[{"i":0,"text":"rūpaṁ mahat te bahu-vaktra-netraṁ","startMs":0,"endMs":2640},{"i":1,"text":"mahā-bāho bahu-bāhūru-pādam","startMs":3120,"endMs":5424},{"i":2,"text":"bahūdaraṁ bahu-danṣṭrā-karālaṁ","startMs":5904,"endMs":7800},{"i":3,"text":"dṛṣṭvā lokāḥ pravyathitās tathāham","startMs":8280,"endMs":11472},{"i":4,"text":"हे महाबाहो!","startMs":12072,"endMs":12888},{"i":5,"text":"अनेक मुखों, आँखों, हाथों, जांघों, पैरों, पेटों और भयानक दाढ़ों वाले आपके इस विशाल रूप को देखकर सभी लोग अत्यंत भयभीत हो रहे हैं, और मैं भी डर रहा हूँ।","startMs":13108,"endMs":22828}]