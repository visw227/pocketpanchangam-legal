[{"i":0,"text":"dhyāyato viṣayān puṁsaḥ saṅgas teṣūpajāyate","startMs":0,"endMs":2856},{"i":1,"text":"saṅgāt sañjāyate kāmaḥ kāmāt krodho 'bhijāyate","startMs":3336,"endMs":7896},{"i":2,"text":"Dwelling on objects breeds attachment; attachment breeds desire; desire breeds anger.","startMs":8496,"endMs":13992}]