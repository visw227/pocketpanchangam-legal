[{"i":0,"text":"śreyān sva-dharmo viguṇaḥ para-dharmāt sv-anuṣṭhitāt","startMs":0,"endMs":5064},{"i":1,"text":"sva-dharme nidhanaṁ śreyaḥ para-dharmo bhayāvahaḥ","startMs":5544,"endMs":8304},{"i":2,"text":"Better one's own path, though imperfect, than another's path done perfectly.","startMs":8904,"endMs":13512}]