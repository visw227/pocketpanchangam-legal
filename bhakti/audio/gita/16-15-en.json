[{"i":0,"text":"āḍhyo ’bhijanavān asmi ko ’nyo ’sti sadṛśo mayā","startMs":0,"endMs":4152},{"i":1,"text":"yakṣye dāsyāmi modiṣya ity ajñāna-vimohitāḥ","startMs":4632,"endMs":8640},{"i":2,"text":"aneka-citta-vibhrāntā moha-jāla-samāvṛtāḥ","startMs":9120,"endMs":12624},{"i":3,"text":"prasaktāḥ kāma-bhogeṣu patanti narake ’śucau","startMs":13104,"endMs":17400},{"i":4,"text":"\"I am rich and born in a noble family.","startMs":18000,"endMs":19920},{"i":5,"text":"Who else is equal to me?","startMs":20140,"endMs":21220},{"i":6,"text":"I will perform sacrifices, I will give charity, and I will rejoice.\"","startMs":21440,"endMs":25208},{"i":7,"text":"Thus they are deluded by ignorance.","startMs":25428,"endMs":27204}]