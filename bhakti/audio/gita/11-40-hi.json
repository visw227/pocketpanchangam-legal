[{"i":0,"text":"namaḥ purastād atha pṛṣṭhatas te","startMs":0,"endMs":2856},{"i":1,"text":"namo ’stu te sarvata eva sarva","startMs":3336,"endMs":5784},{"i":2,"text":"ananta-vīryāmita-vikramas tvaṁ","startMs":6264,"endMs":9912},{"i":3,"text":"sarvaṁ samāpnoṣi tato ’si sarvaḥ","startMs":10392,"endMs":13344},{"i":4,"text":"आपको आगे से और पीछे से भी नमस्कार!","startMs":13944,"endMs":16176},{"i":5,"text":"हे सर्वस्वरूप, आपको सब ओर से नमस्कार हो।","startMs":16396,"endMs":18748},{"i":6,"text":"अनंत वीर्य और असीम पराक्रम वाले आप सब कुछ व्याप्त किए हुए हैं, इसलिए आप ही सब कुछ हैं।","startMs":18968,"endMs":24272}]