[{"i":0,"text":"vāsānsi jīrṇāni yathā vihāya","startMs":0,"endMs":2352},{"i":1,"text":"navāni gṛhṇāti naro ’parāṇi","startMs":2832,"endMs":5136},{"i":2,"text":"tathā śarīrāṇi vihāya jīrṇānya","startMs":5616,"endMs":7752},{"i":3,"text":"nyāni sanyāti navāni dehī","startMs":8232,"endMs":10584},{"i":4,"text":"जैसे मनुष्य पुराने कपड़ों को छोड़कर नए कपड़े धारण करता है, वैसे ही जीवात्मा पुराने शरीरों को छोड़कर नए शरीरों में प्रवेश करती है।","startMs":11184,"endMs":18528}]