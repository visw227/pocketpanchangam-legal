[{"i":0,"text":"tasmāt tvam uttiṣṭha yaśo labhasva","startMs":0,"endMs":2856},{"i":1,"text":"jitvā śatrūn bhuṅkṣva rājyaṁ samṛddham","startMs":3336,"endMs":5928},{"i":2,"text":"mayaivaite nihatāḥ pūrvam eva","startMs":6408,"endMs":9312},{"i":3,"text":"nimitta-mātraṁ bhava savya-sācin","startMs":9792,"endMs":12096},{"i":4,"text":"Therefore, stand up and gain glory!","startMs":12696,"endMs":14352},{"i":5,"text":"Conquer your enemies and enjoy a prosperous kingdom.","startMs":14572,"endMs":16924},{"i":6,"text":"These warriors have already been slain by Me; you be just an instrument, O Arjuna.","startMs":17144,"endMs":21608}]