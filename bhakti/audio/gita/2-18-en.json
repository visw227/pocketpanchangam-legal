[{"i":0,"text":"antavanta ime dehā nityasyoktāḥ śarīriṇaḥ","startMs":0,"endMs":4416},{"i":1,"text":"anāśino ’prameyasya tasmād yudhyasva bhārata","startMs":4896,"endMs":9000},{"i":2,"text":"Only the physical body of the eternal, indestructible, and immeasurable soul is subject to destruction.","startMs":9600,"endMs":14904},{"i":3,"text":"Therefore, fight, O Bharata.","startMs":15124,"endMs":16396}]