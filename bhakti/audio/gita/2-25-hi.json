[{"i":0,"text":"avyakto ’yam acintyo ’yam avikāryo ’yam ucyate","startMs":0,"endMs":4896},{"i":1,"text":"tasmādevaṁ viditvainaṁ nānuśocitum arhasi","startMs":5376,"endMs":9384},{"i":2,"text":"यह आत्मा अव्यक्त, अचिन्त्य और विकाररहित कही जाती है।","startMs":9984,"endMs":12864},{"i":3,"text":"इसलिए, इसे ऐसा जानकर तुम्हें शोक नहीं करना चाहिए।","startMs":13084,"endMs":15508}]