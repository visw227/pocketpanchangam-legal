[{"i":0,"text":"eṣā te ’bhihitā sānkhye","startMs":0,"endMs":2952},{"i":1,"text":"buddhir yoge tvimāṁ śṛṇu","startMs":3432,"endMs":5280},{"i":2,"text":"buddhyā yukto yayā pārtha","startMs":5760,"endMs":7656},{"i":3,"text":"karma-bandhaṁ prahāsyasi","startMs":8136,"endMs":10032},{"i":4,"text":"हे पार्थ!","startMs":10632,"endMs":11400},{"i":5,"text":"यह ज्ञान मैंने तुम्हें सांख्य योग के अनुसार दिया है।","startMs":11620,"endMs":14236},{"i":6,"text":"अब तुम इसे कर्मयोग के रूप में सुनो, जिससे जुड़कर तुम कर्मों के बंधनों से मुक्त हो जाओगे।","startMs":14456,"endMs":19952}]