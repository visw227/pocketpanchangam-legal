[{"i":0,"text":"acchedyo ’yam adāhyo ’yam akledyo ’śoṣya eva ca","startMs":0,"endMs":4608},{"i":1,"text":"nityaḥ sarva-gataḥ sthāṇur acalo ’yaṁ sanātanaḥ","startMs":5088,"endMs":8640},{"i":2,"text":"The soul cannot be cut, burned, wet, or dried.","startMs":9240,"endMs":12048},{"i":3,"text":"It is eternal, all-pervading, stable, immovable, and ancient.","startMs":12268,"endMs":16924}]