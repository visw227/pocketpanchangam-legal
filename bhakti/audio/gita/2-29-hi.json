[{"i":0,"text":"āścarya-vat paśyati kaścid enan","startMs":0,"endMs":3192},{"i":1,"text":"āścarya-vad vadati tathaiva cānyaḥ","startMs":3672,"endMs":6912},{"i":2,"text":"āścarya-vac cainam anyaḥ śṛṇoti","startMs":7392,"endMs":10584},{"i":3,"text":"śrutvāpyenaṁ veda na caiva kaścit","startMs":11064,"endMs":13656},{"i":4,"text":"कोई इस आत्मा को आश्चर्य से देखता है, कोई इसके बारे में आश्चर्य से बात करता है और कोई इसे आश्चर्य से सुनता है।","startMs":14256,"endMs":20016},{"i":5,"text":"लेकिन सुनने के बाद भी इसे कोई सचमुच नहीं समझ पाता।","startMs":20236,"endMs":23356}]