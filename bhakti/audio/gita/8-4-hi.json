[{"i":0,"text":"adhibhūtaṁ kṣaro bhāvaḥ puruṣaś cādhidaivatam","startMs":0,"endMs":3744},{"i":1,"text":"adhiyajño ’ham evātra dehe deha-bhṛtāṁ vara","startMs":4224,"endMs":7488},{"i":2,"text":"हे देहधारियों में श्रेष्ठ अर्जुन!","startMs":8088,"endMs":9864},{"i":3,"text":"नाशवान भौतिक प्रकृति अधिभूत है, विराट पुरुष अधिदैव है, और इस शरीर में रहने वाला मैं स्वयं ही अधियज्ञ हूँ।","startMs":10084,"endMs":17308}]