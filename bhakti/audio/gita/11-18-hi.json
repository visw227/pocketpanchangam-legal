[{"i":0,"text":"tvam akṣaraṁ paramaṁ veditavyaṁ","startMs":0,"endMs":2448},{"i":1,"text":"tvam asya viśvasya paraṁ nidhānam","startMs":2928,"endMs":5280},{"i":2,"text":"tvam avyayaḥ śāśvata-dharma-goptā","startMs":5760,"endMs":8808},{"i":3,"text":"sanātanas tvaṁ puruṣo mato me","startMs":9288,"endMs":11592},{"i":4,"text":"आप ही जानने योग्य परम अविनाशी तत्व हैं।","startMs":12192,"endMs":14544},{"i":5,"text":"आप इस ब्रह्मांड के परम आधार हैं।","startMs":14764,"endMs":16540},{"i":6,"text":"आप कभी नष्ट न होने वाले, सनातन धर्म के रक्षक और अविनाशी पुरुष हैं, ऐसा मेरा मत है।","startMs":16760,"endMs":21944}]