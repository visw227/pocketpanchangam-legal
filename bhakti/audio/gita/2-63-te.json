[{"i":0,"text":"krodhād bhavati sammohaḥ sammohāt smṛti-vibhramaḥ","startMs":0,"endMs":5400},{"i":1,"text":"smṛti-bhraṁśād buddhi-nāśo buddhi-nāśāt praṇaśyati","startMs":5880,"endMs":10296},{"i":2,"text":"కోపం నుండి మోహం, మోహం నుండి మతిమరుపు, దాని నుండి బుద్ధినాశం కలుగుతుంది.","startMs":10896,"endMs":18048}]