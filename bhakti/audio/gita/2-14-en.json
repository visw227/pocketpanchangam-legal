[{"i":0,"text":"mātrā-sparśās tu kaunteya śītoṣṇa-sukha-duḥkha-dāḥ","startMs":0,"endMs":5256},{"i":1,"text":"āgamāpāyino 'nityās tāṁs titikṣasva bhārata","startMs":5736,"endMs":9528},{"i":2,"text":"Pleasure and pain come and go like seasons; they are impermanent.","startMs":10128,"endMs":13248},{"i":3,"text":"Endure them with patience.","startMs":13468,"endMs":14932}]