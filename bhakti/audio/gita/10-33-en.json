[{"i":0,"text":"अहमेवाक्षय: कालो धाताहं विश्वतोमुख:","startMs":0,"endMs":3240},{"i":1,"text":"33","startMs":3720,"endMs":4512},{"i":2,"text":"akṣarāṇām a-kāro ’smi dvandvaḥ sāmāsikasya ca","startMs":4992,"endMs":9408},{"i":3,"text":"aham evākṣayaḥ kālo dhātāhaṁ viśvato-mukhaḥ","startMs":9888,"endMs":13896},{"i":4,"text":"Among letters I am the letter 'A', and among compounds I am the dual compound.","startMs":14496,"endMs":18528},{"i":5,"text":"I am also endless time, and the creator whose faces are on all sides.","startMs":18748,"endMs":22396}]