[{"i":0,"text":"yāvat sañjāyate kiñcit sattvaṁ sthāvara-jaṅgamam","startMs":0,"endMs":3408},{"i":1,"text":"kṣetra-kṣetrajña-sanyogāt tad viddhi bharatarṣabha","startMs":3888,"endMs":7752},{"i":2,"text":"हे भरतश्रेष्ठ!","startMs":8352,"endMs":9432},{"i":3,"text":"जो भी चर या अचर प्राणी उत्पन्न होता है, उसे तुम क्षेत्र और क्षेत्रज्ञ के संयोग से ही उत्पन्न जानो।","startMs":9652,"endMs":14836}]