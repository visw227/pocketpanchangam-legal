[{"i":0,"text":"tasmād yasya mahā-bāho nigṛhītāni sarvaśaḥ","startMs":0,"endMs":4200},{"i":1,"text":"indriyāṇīndriyārthebhyas tasya prajñā pratiṣṭhitā","startMs":4680,"endMs":8544},{"i":2,"text":"हे महाबाहो!","startMs":9144,"endMs":10032},{"i":3,"text":"इसलिए जिस मनुष्य की इंद्रियां उनके विषयों से पूरी तरह वश में होती हैं, उसकी बुद्धि स्थिर होती है।","startMs":10252,"endMs":15628}]