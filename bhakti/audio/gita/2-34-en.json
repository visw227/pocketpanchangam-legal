[{"i":0,"text":"akīrtiṁ cāpi bhūtāni","startMs":0,"endMs":1896},{"i":1,"text":"kathayiṣyanti te ’vyayām","startMs":2376,"endMs":4224},{"i":2,"text":"sambhāvitasya cākīrtir","startMs":4704,"endMs":6456},{"i":3,"text":"maraṇād atiricyate","startMs":6936,"endMs":8520},{"i":4,"text":"People will speak of your dishonor for all time.","startMs":9120,"endMs":11280},{"i":5,"text":"For a respected person, dishonor is worse than death.","startMs":11500,"endMs":14236}]