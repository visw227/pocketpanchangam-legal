[{"i":0,"text":"adhiyajñaḥ kathaṁ ko ’tra dehe ’smin madhusūdana","startMs":0,"endMs":3792},{"i":1,"text":"prayāṇa-kāle ca kathaṁ jñeyo ’si niyatātmabhiḥ","startMs":4272,"endMs":7872},{"i":2,"text":"మధుసూదనా!","startMs":8472,"endMs":9360},{"i":3,"text":"ఈ శరీరంలో అధియజ్ఞుడు ఎవరు?","startMs":9580,"endMs":11308},{"i":4,"text":"ఆయన ఎలా ఉంటాడు?","startMs":11528,"endMs":13496},{"i":5,"text":"మనస్సును అదుపులో ఉంచుకున్నవారు మరణకాలంలో నిన్ను ఎలా తెలుసుకోగలరు?","startMs":13716,"endMs":18828}]