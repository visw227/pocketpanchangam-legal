[{"i":0,"text":"āḍhyo ’bhijanavān asmi ko ’nyo ’sti sadṛśo mayā","startMs":0,"endMs":4056},{"i":1,"text":"yakṣye dāsyāmi modiṣya ity ajñāna-vimohitāḥ","startMs":4536,"endMs":9096},{"i":2,"text":"aneka-citta-vibhrāntā moha-jāla-samāvṛtāḥ","startMs":9576,"endMs":13920},{"i":3,"text":"prasaktāḥ kāma-bhogeṣu patanti narake ’śucau","startMs":14400,"endMs":18456},{"i":4,"text":"\"मैं धनवान हूँ और कुलीन हूँ, मेरे समान दूसरा कौन है?","startMs":19056,"endMs":22704},{"i":5,"text":"मैं यज्ञ करूँगा, दान दूँगा और आमोद-प्रमोद करूँगा\", इस प्रकार वे अज्ञान से मोहित रहते हैं।","startMs":22924,"endMs":28492}]