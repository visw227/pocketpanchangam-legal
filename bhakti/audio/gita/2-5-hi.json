[{"i":0,"text":"gurūnahatvā hi mahānubhāvān","startMs":0,"endMs":2136},{"i":1,"text":"śreyo bhoktuṁ bhaikṣyamapīha loke","startMs":2616,"endMs":4920},{"i":2,"text":"hatvārtha-kāmāṁstu gurūnihaiva","startMs":5400,"endMs":7896},{"i":3,"text":"bhuñjīya bhogān rudhira-pradigdhān","startMs":8376,"endMs":10536},{"i":4,"text":"इन महान गुरुओं को मारने से अच्छा तो इस संसार में भीख मांगकर जीवन बिताना है।","startMs":11136,"endMs":15360},{"i":5,"text":"इन्हें मारकर हम जो भी भोग भोगेंगे, वे खून से सने होंगे।","startMs":15580,"endMs":18508}]