[{"i":0,"text":"antavanta ime dehā nityasyoktāḥ śarīriṇaḥ","startMs":0,"endMs":4200},{"i":1,"text":"anāśino ’prameyasya tasmād yudhyasva bhārata","startMs":4680,"endMs":8784},{"i":2,"text":"अविनाशी और अनंत आत्मा के यह शरीर ही नाशवान कहे गए हैं।","startMs":9384,"endMs":12576},{"i":3,"text":"इसलिए, हे भारत, तुम युद्ध करो।","startMs":12796,"endMs":14908}]