[{"i":0,"text":"brāhmaṇa-kṣatriya-viśāṁ śūdrāṇāṁ ca parantapa","startMs":0,"endMs":4008},{"i":1,"text":"karmāṇi pravibhaktāni svabhāva-prabhavair guṇaiḥ","startMs":4488,"endMs":8184},{"i":2,"text":"हे परंतप!","startMs":8784,"endMs":9672},{"i":3,"text":"ब्राह्मणों, क्षत्रियों, वैश्यों और शूद्रों के कर्म उनके अपने स्वभाव से उत्पन्न गुणों के अनुसार बांटे गए हैं।","startMs":9892,"endMs":16852}]