[{"i":0,"text":"अहमेवाक्षय: कालो धाताहं विश्वतोमुख:","startMs":0,"endMs":2952},{"i":1,"text":"33","startMs":3432,"endMs":4176},{"i":2,"text":"akṣarāṇām a-kāro ’smi dvandvaḥ sāmāsikasya ca","startMs":4656,"endMs":9672},{"i":3,"text":"aham evākṣayaḥ kālo dhātāhaṁ viśvato-mukhaḥ","startMs":10152,"endMs":14160},{"i":4,"text":"अक्षरों में मैं 'अ' कार हूँ और समासों में द्वंद्व समास हूँ।","startMs":14760,"endMs":17880},{"i":5,"text":"मैं ही अविनाशी काल हूँ और सब ओर मुख वाला धाता (सृष्टिकर्ता) हूँ।","startMs":18100,"endMs":21556}]