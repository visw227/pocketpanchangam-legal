[{"i":0,"text":"kirīṭinaṁ gadinaṁ cakra-hastam","startMs":0,"endMs":2136},{"i":1,"text":"icchāmi tvāṁ draṣṭum ahaṁ tathaiva","startMs":2616,"endMs":5424},{"i":2,"text":"tenaiva rūpeṇa catur-bhujena","startMs":5904,"endMs":7896},{"i":3,"text":"sahasra-bāho bhava viśva-mūrte","startMs":8376,"endMs":10680},{"i":4,"text":"मैं आपको पहले की तरह ही मुकुट धारण किए हुए तथा हाथ में गदा और चक्र लिए देखना चाहता हूँ।","startMs":11280,"endMs":16080},{"i":5,"text":"हे सहस्रबाहु, हे विश्वरूप, आप अपने उसी चतुर्भुज रूप में प्रकट हो जाइए।","startMs":16300,"endMs":20908}]