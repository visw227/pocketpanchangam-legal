[{"i":0,"text":"krodhād bhavati sammohaḥ sammohāt smṛti-vibhramaḥ","startMs":0,"endMs":4656},{"i":1,"text":"smṛti-bhraṁśād buddhi-nāśo buddhi-nāśāt praṇaśyati","startMs":5136,"endMs":10104},{"i":2,"text":"From anger comes delusion; from delusion, loss of memory; from that, the ruin of judgment.","startMs":10704,"endMs":16200}]