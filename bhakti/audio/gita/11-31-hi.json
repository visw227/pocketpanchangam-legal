[{"i":0,"text":"ākhyāhi me ko bhavān ugra-rūpo","startMs":0,"endMs":2856},{"i":1,"text":"namo ’stu te deva-vara prasīda","startMs":3336,"endMs":5232},{"i":2,"text":"vijñātum icchāmi bhavantam ādyaṁ","startMs":5712,"endMs":8568},{"i":3,"text":"na hi prajānāmi tava pravṛttim","startMs":9048,"endMs":12096},{"i":4,"text":"कृपा करके मुझे बताइए कि इस उग्र रूप वाले आप कौन हैं?","startMs":12696,"endMs":15888},{"i":5,"text":"हे देवश्रेष्ठ!","startMs":16108,"endMs":17452},{"i":6,"text":"आपको नमस्कार है, प्रसन्न होइए।","startMs":17672,"endMs":19400},{"i":7,"text":"मैं आदिपुरुष आपको जानना चाहता हूँ, क्योंकि मैं आपकी इस लीला को नहीं समझ पा रहा हूँ।","startMs":19620,"endMs":24612}]