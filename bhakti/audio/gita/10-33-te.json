[{"i": 0, "text": "akṣarāṇām a-kāro ’smi dvandvaḥ sāmāsikasya ca", "startMs": 60, "endMs": 4620}, {"i": 1, "text": "aham evākṣayaḥ kālo dhātāhaṁ viśvato-mukhaḥ", "startMs": 5100, "endMs": 9660}, {"i": 2, "text": "అక్షరాలలో నేను 'అ' కారాన్ని, సమాసాలలో ద్వంద్వ సమాసాన్ని.", "startMs": 10260, "endMs": 15180}, {"i": 3, "text": "నేనే అంతం లేని కాలాన్ని, అన్ని వైపులా ముఖాలు ఉన్న సృష్టికర్తను.", "startMs": 15400, "endMs": 19432}]