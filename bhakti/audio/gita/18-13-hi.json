[{"i":0,"text":"pañcaitāni mahā-bāho kāraṇāni nibodha me","startMs":0,"endMs":2808},{"i":1,"text":"sānkhye kṛtānte proktāni siddhaye sarva-karmaṇām","startMs":3288,"endMs":7032},{"i":2,"text":"हे महाबाहो अर्जुन!","startMs":7632,"endMs":8976},{"i":3,"text":"सभी कर्मों की सिद्धि के लिए सांख्य शास्त्र में बताए गए इन पांच कारणों को तुम मुझसे सुनो।","startMs":9196,"endMs":13468}]