[{"i":0,"text":"lelihyase grasamānaḥ samantāl","startMs":0,"endMs":2760},{"i":1,"text":"lokān samagrān vadanair jvaladbhiḥ","startMs":3240,"endMs":6096},{"i":2,"text":"tejobhir āpūrya jagat samagraṁ","startMs":6576,"endMs":8880},{"i":3,"text":"bhāsas tavogrāḥ pratapanti viṣṇo","startMs":9360,"endMs":11712},{"i":4,"text":"हे विष्णु!","startMs":12312,"endMs":13584},{"i":5,"text":"आप अपने जलते हुए मुखों से सभी लोकों को निगलते हुए चारों ओर से जीभ लपलपा रहे हैं।","startMs":13804,"endMs":18412},{"i":6,"text":"आपका उग्र प्रकाश अपनी किरणों से पूरे ब्रह्मांड को तपा रहा है।","startMs":18632,"endMs":22280}]