[{"i":0,"text":"śrī bhagavān uvāca","startMs":0,"endMs":1392},{"i":1,"text":"hanta te kathayiṣyāmi divyā hyātma-vibhūtayaḥ","startMs":1872,"endMs":6024},{"i":2,"text":"prādhānyataḥ kuru-śreṣṭha nāstyanto vistarasya me","startMs":6504,"endMs":10512},{"i":3,"text":"श्री भगवान ने कहा: हे कुरुश्रेष्ठ!","startMs":11112,"endMs":13272},{"i":4,"text":"मैं तुम्हें अपनी मुख्य दिव्य विभूतियों के बारे में बताऊंगा, क्योंकि मेरे विस्तार का कोई अंत नहीं है।","startMs":13492,"endMs":19108}]