[{"i":0,"text":"yāmimāṁ puṣpitāṁ vācaṁ pravadanty-avipaścitaḥ","startMs":0,"endMs":3552},{"i":1,"text":"veda-vāda-ratāḥ pārtha nānyad astīti vādinaḥ","startMs":4032,"endMs":8088},{"i":2,"text":"kāmātmānaḥ swarga-parā janma-karma-phala-pradām","startMs":8568,"endMs":15240},{"i":3,"text":"kriyā-viśeṣa-bahulāṁ bhogaiśwarya-gatiṁ prati","startMs":15720,"endMs":26040},{"i":4,"text":"हे पार्थ!","startMs":26640,"endMs":27408},{"i":5,"text":"विवेकहीन लोग वेदों की उन दिखावटी बातों में खो जाते हैं जो केवल स्वर्ग और भोग-विलास का लालच देती हैं, और वे मानते हैं कि इसके अलावा और कुछ नहीं है।","startMs":27628,"endMs":35884}]