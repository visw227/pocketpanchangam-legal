[{"i":0,"text":"yāmimāṁ puṣpitāṁ vācaṁ pravadanty-avipaścitaḥ","startMs":0,"endMs":4104},{"i":1,"text":"veda-vāda-ratāḥ pārtha nānyad astīti vādinaḥ","startMs":4584,"endMs":8592},{"i":2,"text":"kāmātmānaḥ svarga-parā janma-karma-phala-pradām","startMs":9072,"endMs":13632},{"i":3,"text":"kriyā-viśeṣa-bahulāṁ bhogaiśvarya-gatiṁ prati","startMs":14112,"endMs":17904},{"i":4,"text":"हे पार्थ!","startMs":18504,"endMs":19776},{"i":5,"text":"विवेकहीन लोग वेदों की उन दिखावटी बातों में खो जाते हैं जो केवल स्वर्ग और भोग-विलास का लालच देती हैं, और वे मानते हैं कि इसके अलावा और कुछ नहीं है।","startMs":19996,"endMs":28060}]