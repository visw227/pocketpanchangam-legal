[{"i":0,"text":"adhiyajñaḥ kathaṁ ko ’tra dehe ’smin madhusūdana","startMs":0,"endMs":3600},{"i":1,"text":"prayāṇa-kāle ca kathaṁ jñeyo ’si niyatātmabhiḥ","startMs":4080,"endMs":7872},{"i":2,"text":"हे मधुसूदन!","startMs":8472,"endMs":9432},{"i":3,"text":"इस शरीर में अधियज्ञ कौन है और वह कैसे रहता है?","startMs":9652,"endMs":12268},{"i":4,"text":"और मन को वश में रखने वाले लोग अंतकाल में आपको कैसे जानते हैं?","startMs":12488,"endMs":15992}]