[{"i":0,"text":"gurūnahatvā hi mahānubhāvān","startMs":0,"endMs":2136},{"i":1,"text":"śreyo bhoktuṁ bhaikṣyamapīha loke","startMs":2616,"endMs":5664},{"i":2,"text":"hatvārtha-kāmāṁstu gurūnihaiva","startMs":6144,"endMs":8640},{"i":3,"text":"bhuñjīya bhogān rudhira-pradigdhān","startMs":9120,"endMs":11328},{"i":4,"text":"It is better to live on alms in this world than to kill these noble teachers.","startMs":11928,"endMs":15624},{"i":5,"text":"By killing them, any wealth and pleasures we enjoy will be stained with blood.","startMs":15844,"endMs":19540}]