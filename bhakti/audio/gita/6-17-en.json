[{"i":0,"text":"yuktāhāra-vihārasya yukta-ceṣṭasya karmasu","startMs":0,"endMs":3696},{"i":1,"text":"yukta-svapnāvabodhasya yogo bhavati duḥkha-hā","startMs":4176,"endMs":7776},{"i":2,"text":"For one moderate in food, recreation, work, and sleep, yoga destroys all sorrow.","startMs":8376,"endMs":12648}]