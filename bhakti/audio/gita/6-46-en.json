[{"i":0,"text":"tapasvibhyo ’dhiko yogī","startMs":0,"endMs":2088},{"i":1,"text":"jñānibhyo ’pi mato ’dhikaḥ","startMs":2568,"endMs":5016},{"i":2,"text":"karmibhyaś cādhiko yogī","startMs":5496,"endMs":7344},{"i":3,"text":"tasmād yogī bhavārjuna","startMs":7824,"endMs":9432},{"i":4,"text":"A yogi is superior to the ascetics, superior to the wise, and superior to those who perform ritualistic actions.","startMs":10032,"endMs":16176},{"i":5,"text":"Therefore, Arjuna, be a yogi.","startMs":16396,"endMs":18124}]