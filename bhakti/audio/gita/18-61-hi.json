[{"i":0,"text":"īśvaraḥ sarva-bhūtānāṁ hṛd-deśe ‘rjuna tiṣṭhati","startMs":0,"endMs":4008},{"i":1,"text":"bhrāmayan sarva-bhūtāni yantrārūḍhāni māyayā","startMs":4488,"endMs":7392},{"i":2,"text":"हे अर्जुन!","startMs":7992,"endMs":8688},{"i":3,"text":"ईश्वर सभी प्राणियों के हृदय में बसते हैं।","startMs":8908,"endMs":10948},{"i":4,"text":"वे अपनी माया से सभी जीवों को इस तरह घुमाते हैं जैसे वे किसी यंत्र पर सवार हों।","startMs":11168,"endMs":15440}]