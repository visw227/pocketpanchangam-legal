[{"i":0,"text":"arjuna uvāca","startMs":0,"endMs":1152},{"i":1,"text":"kiṁ tad brahma kim adhyātmaṁ kiṁ karma puruṣottama","startMs":1632,"endMs":6288},{"i":2,"text":"adhibhūtaṁ ca kiṁ proktam adhidaivaṁ kim ucyate","startMs":6768,"endMs":10776},{"i":3,"text":"అర్జునుడు అడిగాడు: పురుషోత్తమా!","startMs":11376,"endMs":13680},{"i":4,"text":"ఆ బ్రహ్మము అంటే ఏమిటి?","startMs":13900,"endMs":16060},{"i":5,"text":"అధ్యాత్మము అంటే ఏమిటి?","startMs":16280,"endMs":17672},{"i":6,"text":"కర్మ అంటే ఏమిటి?","startMs":17892,"endMs":19044},{"i":7,"text":"అధిభూతము అని దేనిని అంటారు?","startMs":19264,"endMs":21304},{"i":8,"text":"అధిదైవము అని దేనికి పేరు?","startMs":21524,"endMs":24140}]