[{"i":0,"text":"swayam evātmanātmānaṁ vettha tvaṁ puruṣottama","startMs":0,"endMs":8712},{"i":1,"text":"bhūta-bhāvana bhūteśa deva-deva jagat-pate","startMs":9192,"endMs":12336},{"i":2,"text":"हे पुरुषोत्तम!","startMs":12936,"endMs":13896},{"i":3,"text":"हे जीवों को उत्पन्न करने वाले, जीवों के स्वामी, देवों के देव और जगत के स्वामी!","startMs":14116,"endMs":18340},{"i":4,"text":"आप स्वयं ही अपने आप से अपने स्वरूप को जानते हैं।","startMs":18560,"endMs":21248}]