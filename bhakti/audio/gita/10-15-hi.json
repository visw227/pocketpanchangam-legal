[{"i":0,"text":"svayam evātmanātmānaṁ vettha tvaṁ puruṣottama","startMs":0,"endMs":4200},{"i":1,"text":"bhūta-bhāvana bhūteśa deva-deva jagat-pate","startMs":4680,"endMs":8424},{"i":2,"text":"हे पुरुषोत्तम!","startMs":9024,"endMs":10032},{"i":3,"text":"हे जीवों को उत्पन्न करने वाले, जीवों के स्वामी, देवों के देव और जगत के स्वामी!","startMs":10252,"endMs":14476},{"i":4,"text":"आप स्वयं ही अपने आप से अपने स्वरूप को जानते हैं।","startMs":14696,"endMs":17384}]