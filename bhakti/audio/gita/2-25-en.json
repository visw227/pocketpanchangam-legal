[{"i":0,"text":"avyakto ’yam acintyo ’yam avikāryo ’yam ucyate","startMs":0,"endMs":4344},{"i":1,"text":"tasmādevaṁ viditvainaṁ nānuśocitum arhasi","startMs":4824,"endMs":8280},{"i":2,"text":"The soul is said to be unmanifest, unthinkable, and unchanging.","startMs":8880,"endMs":12456},{"i":3,"text":"Knowing this, you should not grieve.","startMs":12676,"endMs":14212}]