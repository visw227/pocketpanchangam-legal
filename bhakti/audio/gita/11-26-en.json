[{"i":0,"text":"amī ca tvāṁ dhṛtarāṣṭrasya putrāḥ","startMs":0,"endMs":3000},{"i":1,"text":"sarve sahaivāvani-pāla-saṅghaiḥ","startMs":3480,"endMs":6240},{"i":2,"text":"bhīṣmo droṇaḥ sūta-putras tathāsau","startMs":6720,"endMs":9216},{"i":3,"text":"sahāsmadīyair api yodha-mukhyaiḥ","startMs":9696,"endMs":12240},{"i":4,"text":"vaktrāṇi te tvaramāṇā viśanti","startMs":12720,"endMs":14976},{"i":5,"text":"danṣṭrā-karālāni bhayānakāni","startMs":15456,"endMs":17808},{"i":6,"text":"kecid vilagnā daśanāntareṣu","startMs":18288,"endMs":20184},{"i":7,"text":"sandṛśyante cūrṇitair uttamāṅgaiḥ","startMs":20664,"endMs":23304},{"i":8,"text":"All the sons of Dhritarashtra, along with many kings, Bhishma, Drona, Karna, and our own chief warriors, are rushing towards You.","startMs":23904,"endMs":30624}]