[{"i":0,"text":"sañjaya uvāca","startMs":0,"endMs":1440},{"i":1,"text":"ity arjunaṁ vāsudevas tathoktvā","startMs":1920,"endMs":4680},{"i":2,"text":"svakaṁ rūpaṁ darśayām āsa bhūyaḥ","startMs":5160,"endMs":7872},{"i":3,"text":"āśvāsayām āsa ca bhītam enaṁ","startMs":8352,"endMs":10608},{"i":4,"text":"bhūtvā punaḥ saumya-vapur mahātmā","startMs":11088,"endMs":13632},{"i":5,"text":"Sanjaya said: Having spoken thus to Arjuna, Krishna showed His own gentle form again.","startMs":14232,"endMs":18960},{"i":6,"text":"The Great Soul then assumed His peaceful human form and comforted the frightened Arjuna.","startMs":19180,"endMs":23404}]