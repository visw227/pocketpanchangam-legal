[{"i":0,"text":"yathā nadīnāṁ bahavo ’mbu-vegāḥ","startMs":0,"endMs":2808},{"i":1,"text":"samudram evābhimukhā dravanti","startMs":3288,"endMs":5784},{"i":2,"text":"tathā tavāmī nara-loka-vīrā","startMs":6264,"endMs":8400},{"i":3,"text":"viśanti vaktrāṇy abhivijvalanti","startMs":8880,"endMs":11568},{"i":4,"text":"Just as many rapid rivers flow towards the ocean, so do these great warriors of the human world enter Your blazing mouths.","startMs":12168,"endMs":18936}]