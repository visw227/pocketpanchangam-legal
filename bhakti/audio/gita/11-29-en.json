[{"i":0,"text":"yathā pradīptaṁ jvalanaṁ pataṅgā","startMs":0,"endMs":2208},{"i":1,"text":"viśanti nāśāya samṛddha-vegāḥ","startMs":2688,"endMs":5088},{"i":2,"text":"tathaiva nāśāya viśanti lokās","startMs":5568,"endMs":7704},{"i":3,"text":"tavāpi vaktrāṇi samṛddha-vegāḥ","startMs":8184,"endMs":10488},{"i":4,"text":"Just as moths rush with great speed into a blazing fire to be destroyed, so do these people enter Your mouths to meet their destruction.","startMs":11088,"endMs":17160}]