[{"i":0,"text":"arjuna uvāca","startMs":0,"endMs":1104},{"i":1,"text":"paśyāmi devāns tava deva dehe","startMs":1584,"endMs":4080},{"i":2,"text":"sarvāns tathā bhūta-viśeṣa-saṅghān","startMs":4560,"endMs":7248},{"i":3,"text":"brahmāṇam īśaṁ kamalāsana-stham","startMs":7728,"endMs":10080},{"i":4,"text":"ṛṣīnś ca sarvān uragānś ca divyān","startMs":10560,"endMs":13752},{"i":5,"text":"अर्जुन ने कहा: हे देव!","startMs":14352,"endMs":15936},{"i":6,"text":"मैं आपके शरीर में सभी देवताओं, अनेक प्रकार के जीवों, कमल पर विराजमान ब्रह्मा, शिव, सभी ऋषियों और दिव्य सर्पों को देख रहा हूँ।","startMs":16156,"endMs":24220}]