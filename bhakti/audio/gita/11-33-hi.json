[{"i":0,"text":"tasmāt tvam uttiṣṭha yaśo labhasva","startMs":0,"endMs":3192},{"i":1,"text":"jitvā śatrūn bhuṅkṣva rājyaṁ samṛddham","startMs":3672,"endMs":6360},{"i":2,"text":"mayaivaite nihatāḥ pūrvam eva","startMs":6840,"endMs":9744},{"i":3,"text":"nimitta-mātraṁ bhava savya-sācin","startMs":10224,"endMs":12576},{"i":4,"text":"इसलिए तुम उठो और यश प्राप्त करो!","startMs":13176,"endMs":15144},{"i":5,"text":"शत्रुओं को जीतकर समृद्ध राज्य का भोग करो।","startMs":15364,"endMs":17524},{"i":6,"text":"ये सब मेरे द्वारा पहले ही मारे जा चुके हैं, हे अर्जुन!","startMs":17744,"endMs":20552},{"i":7,"text":"तुम तो केवल निमित्त मात्र बन जाओ।","startMs":20772,"endMs":22428}]