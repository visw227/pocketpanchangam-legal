[{"i":0,"text":"sañjaya uvāca","startMs":0,"endMs":1296},{"i":1,"text":"etac chrutvā vacanaṁ keśavasya","startMs":1776,"endMs":4536},{"i":2,"text":"kṛtāñjalir vepamānaḥ kirīṭī","startMs":5016,"endMs":7224},{"i":3,"text":"namaskṛtvā bhūya evāha kṛṣṇaṁ","startMs":7704,"endMs":9912},{"i":4,"text":"sa-gadgadaṁ bhīta-bhītaḥ praṇamya","startMs":10392,"endMs":13200},{"i":5,"text":"Sanjaya said: Hearing these words of Krishna, Arjuna folded his hands, trembling with fear.","startMs":13800,"endMs":19176},{"i":6,"text":"Bowing down again and again, he spoke to Krishna in a choked voice.","startMs":19396,"endMs":23428}]