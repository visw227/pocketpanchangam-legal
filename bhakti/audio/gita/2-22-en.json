[{"i":0,"text":"vāsānsi jīrṇāni yathā vihāya","startMs":0,"endMs":2256},{"i":1,"text":"navāni gṛhṇāti naro ’parāṇi","startMs":2736,"endMs":4992},{"i":2,"text":"tathā śarīrāṇi vihāya jīrṇānya","startMs":5472,"endMs":7608},{"i":3,"text":"nyāni sanyāti navāni dehī","startMs":8088,"endMs":10344},{"i":4,"text":"Just as a person discards worn-out clothes and puts on new ones, the soul discards old bodies and enters new ones.","startMs":10944,"endMs":16368}]