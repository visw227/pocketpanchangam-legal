[{"i":0,"text":"rajo rāgātmakaṁ viddhi tṛṣṇā-saṅga-samudbhavam","startMs":0,"endMs":3504},{"i":1,"text":"tan nibadhnāti kaunteya karma-saṅgena dehinam","startMs":3984,"endMs":7848},{"i":2,"text":"हे कौन्तेय!","startMs":8448,"endMs":9912},{"i":3,"text":"रजोगुण को राग रूप समझो, जो कामना और आसक्ति से पैदा होता है।","startMs":10132,"endMs":13780},{"i":4,"text":"वह जीवात्मा को कर्मों की आसक्ति से बाँधता है।","startMs":14000,"endMs":16424}]