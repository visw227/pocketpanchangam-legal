[{"i":0,"text":"Show the dhupam and the deepam to Swamy.","startMs":2286,"endMs":4206},{"i":1,"text":"Om Sri Dhanvantaraye Namaha ।","startMs":4426,"endMs":5890},{"i":2,"text":"Dhupam Aghrapayami ।","startMs":6110,"endMs":6998},{"i":3,"text":"Om Sri Dhanvantaraye Namaha ।","startMs":7218,"endMs":8682},{"i":4,"text":"Deepam Darshayami ॥","startMs":8902,"endMs":9982},{"i":5,"text":"Offer the naivedyam you have prepared, the fruits, the coconut and water.","startMs":10202,"endMs":13970},{"i":6,"text":"Om Sri Dhanvantaraye Namaha ।","startMs":14190,"endMs":15654},{"i":7,"text":"Naivedyam Nivedayami ॥","startMs":15874,"endMs":17218},{"i":8,"text":"Then offer betel leaves and betel nuts.","startMs":17438,"endMs":19478},{"i":9,"text":"Om Sri Dhanvantaraye Namaha ।","startMs":19698,"endMs":21162},{"i":10,"text":"Tambulam Samarpayami ॥","startMs":21382,"endMs":22654}]