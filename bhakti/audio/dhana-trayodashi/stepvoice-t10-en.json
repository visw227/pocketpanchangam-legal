[{"i":0,"text":"Show the dhupam and the deepam to Swamy.","startMs":2286,"endMs":4206},{"i":1,"text":"Om Sri Dhanvantaraye Namaha ।","startMs":4426,"endMs":5770},{"i":2,"text":"Dhupam Aghrapayami ।","startMs":5990,"endMs":6998},{"i":3,"text":"Om Sri Dhanvantaraye Namaha ।","startMs":7218,"endMs":8682},{"i":4,"text":"Deepam Darshayami ॥","startMs":8902,"endMs":9910},{"i":5,"text":"Offer the naivedyam you have prepared, the fruits, the coconut and water.","startMs":10130,"endMs":14090},{"i":6,"text":"Om Sri Dhanvantaraye Namaha ।","startMs":14310,"endMs":15774},{"i":7,"text":"Naivedyam Nivedayami ॥","startMs":15994,"endMs":17338},{"i":8,"text":"Then offer betel leaves and betel nuts.","startMs":17558,"endMs":19598},{"i":9,"text":"Om Sri Dhanvantaraye Namaha ।","startMs":19818,"endMs":21402},{"i":10,"text":"Tambulam Samarpayami ॥","startMs":21622,"endMs":22894}]