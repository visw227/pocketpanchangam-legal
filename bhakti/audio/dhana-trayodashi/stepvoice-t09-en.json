[{"i":0,"text":"Show the dhupam and the deepam to Swamy.","startMs":2286,"endMs":4206},{"i":1,"text":"Om Sri Dhanvantaraye Namaha ।","startMs":4426,"endMs":5890},{"i":2,"text":"Dhupam Aghrapayami ।","startMs":6110,"endMs":7190},{"i":3,"text":"Om Sri Dhanvantaraye Namaha ।","startMs":7410,"endMs":8874},{"i":4,"text":"Deepam Darshayami ॥","startMs":9094,"endMs":10102},{"i":5,"text":"Offer the naivedyam you have prepared, the fruits, the coconut and water.","startMs":10322,"endMs":14090},{"i":6,"text":"Om Sri Dhanvantaraye Namaha ।","startMs":14310,"endMs":15894},{"i":7,"text":"Naivedyam Nivedayami ॥","startMs":16114,"endMs":17698},{"i":8,"text":"Then offer betel leaves and betel nuts.","startMs":17918,"endMs":19838},{"i":9,"text":"Om Sri Dhanvantaraye Namaha ।","startMs":20058,"endMs":21594},{"i":10,"text":"Tambulam Samarpayami ॥","startMs":21814,"endMs":23014}]