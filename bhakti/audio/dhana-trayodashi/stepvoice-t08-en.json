[{"i":0,"text":"Pray to Swamy to accept the puja, and offer a flower or akshatalu.","startMs":2406,"endMs":6054},{"i":1,"text":"Om Sri Dhanvantaraye Namaha ।","startMs":6274,"endMs":7858},{"i":2,"text":"Avahayami ॥","startMs":8078,"endMs":8894},{"i":3,"text":"Offer gandham, turmeric, kumkuma, akshatalu and flowers to Swamy.","startMs":9114,"endMs":13386},{"i":4,"text":"Om Sri Dhanvantaraye Namaha ।","startMs":13606,"endMs":15070},{"i":5,"text":"Gandham Samarpayami ।","startMs":15290,"endMs":16442},{"i":6,"text":"Om Sri Dhanvantaraye Namaha ।","startMs":16662,"endMs":18246},{"i":7,"text":"Pushpani Samarpayami ॥","startMs":18466,"endMs":19738}]