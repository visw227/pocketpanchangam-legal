[{"i":0,"text":"Pray to Swamy to accept the puja, and offer a flower or akshatalu.","startMs":2286,"endMs":5934},{"i":1,"text":"Om Sri Dhanvantaraye Namaha ।","startMs":6154,"endMs":7738},{"i":2,"text":"Avahayami ॥","startMs":7958,"endMs":8654},{"i":3,"text":"Offer gandham, turmeric, kumkuma, akshatalu and flowers to Swamy.","startMs":8874,"endMs":13530},{"i":4,"text":"Om Sri Dhanvantaraye Namaha ।","startMs":13750,"endMs":15094},{"i":5,"text":"Gandham Samarpayami ।","startMs":15314,"endMs":16466},{"i":6,"text":"Om Sri Dhanvantaraye Namaha ।","startMs":16686,"endMs":18222},{"i":7,"text":"Pushpani Samarpayami ॥","startMs":18442,"endMs":19834}]