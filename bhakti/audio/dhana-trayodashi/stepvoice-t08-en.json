[{"i":0,"text":"Pray to Swamy to accept the puja, and offer a flower or akshatalu.","startMs":2286,"endMs":5742},{"i":1,"text":"Om Sri Dhanvantaraye Namaha ।","startMs":5962,"endMs":7426},{"i":2,"text":"Avahayami ॥","startMs":7646,"endMs":8462},{"i":3,"text":"Offer gandham, turmeric, kumkuma, akshatalu and flowers to Swamy.","startMs":8682,"endMs":13146},{"i":4,"text":"Om Sri Dhanvantaraye Namaha ।","startMs":13366,"endMs":14830},{"i":5,"text":"Gandham Samarpayami ।","startMs":15050,"endMs":16202},{"i":6,"text":"Om Sri Dhanvantaraye Namaha ।","startMs":16422,"endMs":17886},{"i":7,"text":"Pushpani Samarpayami ॥","startMs":18106,"endMs":19378}]