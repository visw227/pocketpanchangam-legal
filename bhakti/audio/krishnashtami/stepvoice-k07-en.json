[{"i":0,"text":"If you have a small cloth for Balakrishna, dress him in it.","startMs":2214,"endMs":5334},{"i":1,"text":"If not, that is perfectly fine.","startMs":5554,"endMs":7474},{"i":2,"text":"Offer sandalwood and kumkuma gently.","startMs":7694,"endMs":9734},{"i":3,"text":"Decorate with tulasi and flowers.","startMs":9954,"endMs":12066}]