[{"i":0,"text":"If you have a small cloth for Balakrishna, dress him in it.","startMs":2022,"endMs":4830},{"i":1,"text":"If not, that is perfectly fine.","startMs":5050,"endMs":6826},{"i":2,"text":"Offer sandalwood and kumkuma gently.","startMs":7046,"endMs":9206},{"i":3,"text":"Decorate with tulasi and flowers.","startMs":9426,"endMs":11202}]