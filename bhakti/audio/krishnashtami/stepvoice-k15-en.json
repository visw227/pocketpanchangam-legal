[{"i":0,"text":"Offer camphor harathi or lamp harathi.","startMs":1326,"endMs":3822},{"i":1,"text":"Say “Krishnam vande jagadgurum” and bow.","startMs":4042,"endMs":6082},{"i":2,"text":"కృష్ణం వందే జగద్గురుమ్","startMs":7520,"endMs":9872},{"i":3,"text":"ఓం శ్రీ కృష్ణాయ నమః ।","startMs":10352,"endMs":12098},{"i":4,"text":"నీరాజనం సమర్పయామి ॥","startMs":12578,"endMs":14690}]