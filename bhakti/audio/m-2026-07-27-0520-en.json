[{"i":0,"text":"Meditating in the silence of Kailasa…","startMs":2910,"endMs":5022},{"i":1,"text":"Loving Parvati.","startMs":5442,"endMs":6402},{"i":2,"text":"Destroying Adharma…","startMs":7082,"endMs":8354},{"i":3,"text":"Playing with Ganesha and Kartikeya.","startMs":8774,"endMs":10358},{"i":4,"text":"Sitting in absolute calm…","startMs":11038,"endMs":12382},{"i":5,"text":"Yet dancing as Nataraja","startMs":12802,"endMs":14386},{"i":6,"text":"How can one being be all of these?","startMs":15066,"endMs":16842},{"i":7,"text":"Because Sanatana Dharma never taught us to choose between spirituality and life.","startMs":17522,"endMs":21746},{"i":8,"text":"It teaches us to bring spirituality into every role we live.","startMs":22166,"endMs":25238},{"i":9,"text":"Spirituality isn’t escaping life.","startMs":25918,"endMs":27766},{"i":10,"text":"It’s living every role consciously.","startMs":28186,"endMs":29962},{"i":11,"text":"That is balance.","startMs":30642,"endMs":31530},{"i":12,"text":"That is Shiva.","startMs":31950,"endMs":32718},{"i":13,"text":"Everything and nothing.","startMs":33138,"endMs":33954}]