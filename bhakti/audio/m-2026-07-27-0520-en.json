[{"i":0,"text":"Meditating in the silence of Kailasa…","startMs":3366,"endMs":5526},{"i":1,"text":"Loving Parvati.","startMs":5946,"endMs":6954},{"i":2,"text":"Destroying Adharma…","startMs":7634,"endMs":8786},{"i":3,"text":"Playing with Ganesha and Kartikeya.","startMs":9206,"endMs":10934},{"i":4,"text":"Sitting in absolute calm…","startMs":11614,"endMs":13150},{"i":5,"text":"Yet dancing as Nataraja","startMs":13570,"endMs":14962},{"i":6,"text":"How can one being be all of these?","startMs":15642,"endMs":17370},{"i":7,"text":"Because Sanatana Dharma never taught us to choose between spirituality and life.","startMs":18050,"endMs":22010},{"i":8,"text":"It teaches us to bring spirituality into every role we live.","startMs":22430,"endMs":25502},{"i":9,"text":"Spirituality isn’t escaping life.","startMs":26182,"endMs":28150},{"i":10,"text":"It’s living every role consciously.","startMs":28570,"endMs":30346},{"i":11,"text":"That is balance.","startMs":31026,"endMs":31914},{"i":12,"text":"That is Shiva.","startMs":32334,"endMs":33102},{"i":13,"text":"Everything and nothing.","startMs":33522,"endMs":34482}]