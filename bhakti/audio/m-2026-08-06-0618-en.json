[{"i":0,"text":"Some love Him as their dearest Friend,","startMs":3174,"endMs":5214},{"i":1,"text":"Like Arjuna.","startMs":5634,"endMs":6210},{"i":2,"text":"Some as their little Child,","startMs":6890,"endMs":8234},{"i":3,"text":"Like Mother Yashoda.","startMs":8654,"endMs":10694},{"i":4,"text":"Some as their eternal Beloved,","startMs":11374,"endMs":12910},{"i":5,"text":"Like Radha… and the Gopis.","startMs":13330,"endMs":14866},{"i":6,"text":"Some as their Brother,","startMs":15546,"endMs":16434},{"i":7,"text":"Like Subhadra.","startMs":16854,"endMs":17550},{"i":8,"text":"Some as their Master.","startMs":18230,"endMs":19190},{"i":9,"text":"Some as Supreme God.","startMs":19610,"endMs":20762},{"i":10,"text":"That is the beauty of Sanatana Dharma.","startMs":21442,"endMs":23170},{"i":11,"text":"It never tells your heart how it must love Krishna.","startMs":23590,"endMs":26014},{"i":12,"text":"It simply opens the door, giving you the freedom to love God in the way your heart naturally feels for Him.","startMs":26434,"endMs":31474},{"i":13,"text":"Whatever your heart calls Him…","startMs":32154,"endMs":33546},{"i":14,"text":"Krishna listens.","startMs":33966,"endMs":34854},{"i":15,"text":"🙏 Radhe Krishna","startMs":35534,"endMs":36422}]