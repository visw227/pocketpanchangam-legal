[{"i":0,"text":"Some love Him as their dearest Friend,","startMs":3054,"endMs":4638},{"i":1,"text":"Like Arjuna.","startMs":5058,"endMs":5634},{"i":2,"text":"Some as their little Child,","startMs":6314,"endMs":7778},{"i":3,"text":"Like Mother Yashoda.","startMs":8198,"endMs":10814},{"i":4,"text":"Some as their eternal Beloved,","startMs":11494,"endMs":12694},{"i":5,"text":"Like Radha… and the Gopis.","startMs":13114,"endMs":14698},{"i":6,"text":"Some as their Brother,","startMs":15378,"endMs":16266},{"i":7,"text":"Like Subhadra.","startMs":16686,"endMs":17454},{"i":8,"text":"Some as their Master.","startMs":18134,"endMs":19094},{"i":9,"text":"Some as Supreme God.","startMs":19514,"endMs":20594},{"i":10,"text":"That is the beauty of Sanatana Dharma.","startMs":21274,"endMs":22858},{"i":11,"text":"It never tells your heart how it must love Krishna.","startMs":23278,"endMs":26086},{"i":12,"text":"It simply opens the door, giving you the freedom to love God in the way your heart naturally feels for Him.","startMs":26506,"endMs":31882},{"i":13,"text":"Whatever your heart calls Him…","startMs":32562,"endMs":34026},{"i":14,"text":"Krishna listens.","startMs":34446,"endMs":35334},{"i":15,"text":"🙏 Radhe Krishna","startMs":36014,"endMs":36782}]