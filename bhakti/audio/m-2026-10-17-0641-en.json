[{"i":0,"text":"Sharad Navratri — Day Seven","startMs":2406,"endMs":4326},{"i":1,"text":"1. Mother's Protective Hymn","startMs":5006,"endMs":7430},{"i":2,"text":"Sarvasvarupe Sarveshe Sarvashaktisamanvite ।","startMs":8110,"endMs":10990},{"i":3,"text":"Bhayebhyastraahi No Devi Durge Devi Namo'stu Te ॥","startMs":11410,"endMs":14218},{"i":4,"text":"Meaning:","startMs":14898,"endMs":15330},{"i":5,"text":"O Mother who is the embodiment of all forms!","startMs":16010,"endMs":18362},{"i":6,"text":"O ruler of everything, Durga Devi endowed with all powers!","startMs":18582,"endMs":21774},{"i":7,"text":"Protect us from all fears.","startMs":21994,"endMs":23458},{"i":8,"text":"We offer our salutations to you.","startMs":23678,"endMs":25454},{"i":9,"text":"Narayani Stuti from Devi Mahatmyam.","startMs":26134,"endMs":27982},{"i":10,"text":"2. Kalaratri Prayer","startMs":28662,"endMs":30438},{"i":11,"text":"Ekaveni Japakarnapura Nagna Kharasthita ।","startMs":31118,"endMs":33278},{"i":12,"text":"Lamboshthi Karnikakarni Tailabhyaktasharirini ॥","startMs":33698,"endMs":36386},{"i":13,"text":"Vamapadollasallohalatakantakabhushana ।","startMs":36806,"endMs":38966},{"i":14,"text":"Vardhanmurdhadhvaja Krishna Kalaratrirbhayankari ॥","startMs":39386,"endMs":41930},{"i":15,"text":"Brief Meaning:","startMs":42610,"endMs":43306},{"i":16,"text":"This shloka describes the Mother with a single braid, wearing hibiscus flowers on her ears, mounted on a donkey in an unclothed form.","startMs":43986,"endMs":51210},{"i":17,"text":"We meditate upon the fierce form of Mother Kalaratri, who has a dark complexion, a body glistening with oil, and is adorned with iron thorn ornaments.","startMs":51890,"endMs":59378},{"i":18,"text":"Prayer from Sri Navadurga Stotram.","startMs":60058,"endMs":61834},{"i":19,"text":"Name Mantra","startMs":62514,"endMs":63282},{"i":20,"text":"Om Devi Kalaratryai Namah ॥","startMs":63962,"endMs":65690},{"i":21,"text":"Pocket Panchangam · Sanatana Wisdom","startMs":66370,"endMs":68218}]