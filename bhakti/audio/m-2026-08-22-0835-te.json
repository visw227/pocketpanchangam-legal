[{"i":0,"text":"ముందు భాగంలో మనం చూశాం,","startMs":4590,"endMs":6126},{"i":1,"text":"అష్టసిద్ధులు అంటే ఎనిమిది అసాధారణ శక్తులు.","startMs":6546,"endMs":9474},{"i":2,"text":"నవనిధులు అంటే తొమ్మిది దివ్య నిధులు.","startMs":9894,"endMs":12822},{"i":3,"text":"ఇప్పుడు హనుమాన్ చాలీసాలోని పూర్తి పాదాన్ని చూద్దాం:","startMs":13502,"endMs":16814},{"i":4,"text":"“అష్ట సిద్ధి నౌ నిధి కే దాతా","startMs":17234,"endMs":19082},{"i":5,"text":"అస వర దీన జానకీ మాతా”","startMs":19502,"endMs":21854},{"i":6,"text":"ఇక్కడ ముఖ్యమైన పదం — “దాతా”.","startMs":22534,"endMs":24886},{"i":7,"text":"అంటే,  అష్టసిద్ధులు, నవనిధులను ప్రసాదించగలవాడు.","startMs":25306,"endMs":28954},{"i":8,"text":"మరి “అస వర దీన జానకీ మాతా” అంటే?","startMs":29634,"endMs":33282},{"i":9,"text":"“అలాంటి వరాన్ని జానకీమాత ఇచ్చింది” అని.","startMs":33702,"endMs":37662},{"i":10,"text":"అంటే సీతమ్మ హనుమంతుడికి ఈ శక్తులు, నిధులు ఇచ్చిందని కాదు,","startMs":38082,"endMs":44082},{"i":11,"text":"వాటిని ఇతరులకు ప్రసాదించగల వరాన్ని ఇచ్చిందని ఈ పాదం చెబుతుంది.","startMs":44502,"endMs":50070},{"i":12,"text":"ఇంకా అందమైన విషయం ఏంటంటే,","startMs":50750,"endMs":52910},{"i":13,"text":"సీతమ్మను కలిసే ముందే హనుమంతుడు తన శక్తిని చూపించాడు.","startMs":53330,"endMs":57482},{"i":14,"text":"సముద్రం దాటేటప్పుడు మహారూపం.","startMs":58162,"endMs":60586},{"i":15,"text":"లంకలోకి ప్రవేశించేటప్పుడు చిన్న రూపం.","startMs":61006,"endMs":64006},{"i":16,"text":"అంటే ఆయనలో ఆ శక్తులు అప్పటికే ఉన్నాయి.","startMs":64426,"endMs":67498},{"i":17,"text":"కానీ జానకీమాత ఆశీర్వాదంతో,","startMs":68178,"endMs":70602},{"i":18,"text":"ఆ శక్తి కేవలం ఆయన దగ్గర ఉండేది కాదు,","startMs":71022,"endMs":73638},{"i":19,"text":"అది భక్తులకు వరంగా చేరగలిగే శక్తిగా మారింది.","startMs":74058,"endMs":77370},{"i":20,"text":"అందుకే ఈ పాదం హనుమంతుడి మహిమను మాత్రమే కాదు, ","startMs":78050,"endMs":81506},{"i":21,"text":"సీతమ్మ ఆయనపై ఉంచిన విశ్వాసాన్ని కూడా చూపిస్తుంది.","startMs":81926,"endMs":85310},{"i":22,"text":"❤️","startMs":85530,"endMs":85530},{"i":23,"text":"🙏 జై సీతారామ్","startMs":86210,"endMs":87218},{"i":24,"text":"జై హనుమాన్","startMs":87638,"endMs":88598}]