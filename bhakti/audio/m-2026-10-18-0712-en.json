[{"i":0,"text":"Sharannavaratrulu — Eighth Day","startMs":2478,"endMs":4062},{"i":1,"text":"1. Prayer to the Peaceful Form of Ammavaru","startMs":4742,"endMs":7430},{"i":2,"text":"Ya Devi Sarvabhuteshu Shantiroopena Samsthita |","startMs":8110,"endMs":10990},{"i":3,"text":"Namastasyai Namastasyai Namastasyai Namo Namah ||","startMs":11410,"endMs":14146},{"i":4,"text":"Meaning:","startMs":14826,"endMs":15258},{"i":5,"text":"I repeatedly bow to Ammavaru, who resides in all beings in the form of peace.","startMs":15938,"endMs":20162},{"i":6,"text":"Prayer to the peaceful form from Devi Mahatmyam.","startMs":20842,"endMs":22954},{"i":7,"text":"2. Mahagauri Prayer","startMs":23634,"endMs":24906},{"i":8,"text":"Shwete Vrushe Samaroodha Shwetambaradhara Shuchihi |","startMs":25586,"endMs":28394},{"i":9,"text":"Mahagauri Shubham Dadyaanmahadev Pramodada ||","startMs":28814,"endMs":31166},{"i":10,"text":"Meaning:","startMs":31846,"endMs":32230},{"i":11,"text":"May Mahagauri Ammavaru, who is seated on a white bull vehicle, clad in white garments, a pure embodiment, and bestows joy upon Lord Shiva, grant us auspiciousness.","startMs":32910,"endMs":42702},{"i":12,"text":"Prayer from Sri Navadurga Stotram.","startMs":43382,"endMs":45110},{"i":13,"text":"Nama Mantra","startMs":45790,"endMs":46606},{"i":14,"text":"Om Devi Mahagauryai Namah ||","startMs":47286,"endMs":48750},{"i":15,"text":"Pocket Panchangam · Sanatana Gnanam","startMs":49430,"endMs":51470}]