[{"i":0,"text":"Show the dhupam and the deepam to Sri Krishna and Satyabhama Devi.","startMs":2286,"endMs":5478},{"i":1,"text":"Dhupam Aghrapayami ।","startMs":5698,"endMs":6898},{"i":2,"text":"Deepam Darshayami ॥","startMs":7118,"endMs":8078},{"i":3,"text":"Offer the naivedyam you have prepared, the fruits, the coconut and water.","startMs":8298,"endMs":12066},{"i":4,"text":"Om Sri Krishnaya Namaha ।","startMs":12286,"endMs":13558},{"i":5,"text":"Naivedyam Nivedayami ॥","startMs":13778,"endMs":15362},{"i":6,"text":"Then offer betel leaves and betel nuts.","startMs":15582,"endMs":17622},{"i":7,"text":"Tambulam Samarpayami ॥","startMs":17842,"endMs":19042}]