[{"i":0,"text":"In Sanatana Dharma…","startMs":1830,"endMs":3030},{"i":1,"text":"A Guru is not merely a person.","startMs":3450,"endMs":5106},{"i":2,"text":"A Guru is anyone—or anything—who removes ignorance…","startMs":5526,"endMs":8838},{"i":3,"text":"And leads you to Truth.","startMs":9258,"endMs":10458},{"i":4,"text":"It could be a teacher, a shastra (scripture), or God Himself.","startMs":10878,"endMs":14454},{"i":5,"text":"That is why…","startMs":15134,"endMs":15902},{"i":6,"text":"Some find their Guru in Dakshinamurthy.","startMs":16322,"endMs":18242},{"i":7,"text":"Some in Dattatreya.","startMs":18662,"endMs":19550},{"i":8,"text":"Some in Krishna.","startMs":19970,"endMs":20738},{"i":9,"text":"Some in Sai Baba.","startMs":21158,"endMs":22118},{"i":10,"text":"Some in a living Guru.","startMs":22538,"endMs":23546},{"i":11,"text":"And some…","startMs":24226,"endMs":24730},{"i":12,"text":"In the silent voice of the Divine within.","startMs":25150,"endMs":27262},{"i":13,"text":"🙏 Happy Guru Purnima","startMs":27942,"endMs":29022}]