[{"i":0,"text":"In Sanatana Dharma…","startMs":1830,"endMs":3030},{"i":1,"text":"A Guru is not merely a person.","startMs":3450,"endMs":5106},{"i":2,"text":"A Guru is anyone—or anything—who removes ignorance…","startMs":5526,"endMs":8598},{"i":3,"text":"And leads you to Truth.","startMs":9018,"endMs":10098},{"i":4,"text":"It could be a teacher, a shastra (scripture), or God Himself.","startMs":10518,"endMs":14094},{"i":5,"text":"That is why…","startMs":14774,"endMs":15542},{"i":6,"text":"Some find their Guru in Dakshinamurthy.","startMs":15962,"endMs":17882},{"i":7,"text":"Some in Dattatreya.","startMs":18302,"endMs":19382},{"i":8,"text":"Some in Krishna.","startMs":19802,"endMs":20618},{"i":9,"text":"Some in Sai Baba.","startMs":21038,"endMs":21998},{"i":10,"text":"Some in a living Guru.","startMs":22418,"endMs":23570},{"i":11,"text":"And some…","startMs":24250,"endMs":24754},{"i":12,"text":"In the silent voice of the Divine within.","startMs":25174,"endMs":27142},{"i":13,"text":"🙏 Happy Guru Purnima","startMs":27822,"endMs":28830}]