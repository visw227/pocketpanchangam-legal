[{"i":0,"text":"आधी रात उस अंधेरे में क्या हुआ था, जानते हैं?","startMs":2790,"endMs":5334},{"i":1,"text":"इस जन्माष्टमी रात, आइए उस सुंदर कहानी को याद करें।","startMs":5554,"endMs":8674},{"i":2,"text":"🪷","startMs":8894,"endMs":8894},{"i":3,"text":"मथुरा में, वह पूरी रात अंधेरा ही था।","startMs":9574,"endMs":12310},{"i":4,"text":"कारागार के द्वार बंद थे।","startMs":12730,"endMs":14314},{"i":5,"text":"देवकी और वसुदेव बंधन में थे।","startMs":14734,"endMs":16462},{"i":6,"text":"लेकिन जैसे ही आधी रात करीब आई,","startMs":17142,"endMs":18918},{"i":7,"text":"उस अंधेरे में एक दिव्य प्रकाश आया।","startMs":19338,"endMs":21378},{"i":8,"text":"श्री कृष्ण अवतरित हुए।","startMs":22058,"endMs":23402},{"i":9,"text":"🪷","startMs":23622,"endMs":23622},{"i":10,"text":"उस छोटे बालक के साथ","startMs":24302,"endMs":25574},{"i":11,"text":"दुनिया को एक महान संदेश भी आया —","startMs":25994,"endMs":28226},{"i":12,"text":"अंधेरा कितना भी गहरा क्यों न हो,","startMs":28646,"endMs":30686},{"i":13,"text":"प्रकाश आने के लिए एक क्षण ही काफी है।","startMs":31106,"endMs":33146},{"i":14,"text":"💙","startMs":33366,"endMs":33366},{"i":15,"text":"इस पवित्र रात,","startMs":34046,"endMs":35126},{"i":16,"text":"आइए उस बाल कृष्ण को अपने घर में, अपने हृदय में आमंत्रित करें।","startMs":35546,"endMs":38546},{"i":17,"text":"🙏","startMs":38766,"endMs":38766},{"i":18,"text":"ॐ नमो भगवते वासुदेवाय ॥","startMs":39446,"endMs":40982}]