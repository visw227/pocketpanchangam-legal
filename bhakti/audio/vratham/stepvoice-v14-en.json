[{"i":0,"text":"Offer flowers — pushpam samarpayami.","startMs":2862,"endMs":5094},{"i":1,"text":"Offer dhoopam — dhoopam aaghraapayami.","startMs":5314,"endMs":7618},{"i":2,"text":"Show the deepam — deepam darshayami.","startMs":7838,"endMs":9806},{"i":3,"text":"Give camphor harathi — karpoora neeraajanam samarpayami.","startMs":10026,"endMs":13146},{"i":4,"text":"The whole family offers namaskaram to amma.","startMs":13366,"endMs":15406},{"i":5,"text":"ఓం మహాలక్ష్మీ దేవ్యై నమః","startMs":16856,"endMs":19442}]