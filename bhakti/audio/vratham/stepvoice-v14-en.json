[{"i":0,"text":"Offer flowers — pushpam samarpayami.","startMs":2862,"endMs":5166},{"i":1,"text":"Offer dhoopam — dhoopam aaghraapayami.","startMs":5386,"endMs":7498},{"i":2,"text":"Show the deepam — deepam darshayami.","startMs":7718,"endMs":9686},{"i":3,"text":"Give camphor harathi — karpoora neeraajanam samarpayami.","startMs":9906,"endMs":13410},{"i":4,"text":"The whole family offers namaskaram to amma.","startMs":13630,"endMs":15742}]