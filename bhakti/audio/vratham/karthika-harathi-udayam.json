[{"i": 0, "text": "కర్పూరగౌరం కరుణావతారం", "startMs": 0, "endMs": 2212}, {"i": 1, "text": "సంసారసారం భుజగేంద్రహారం ।", "startMs": 2347, "endMs": 4837}, {"i": 2, "text": "సదా వసంతం హృదయారవిందే", "startMs": 5110, "endMs": 7300}, {"i": 3, "text": "భవం భవానీసహితం నమామి ॥", "startMs": 7330, "endMs": 9409}, {"i": 4, "text": "ఓం శ్రీ శివకేశవాభ్యాం నమః ।", "startMs": 9932, "endMs": 12477}, {"i": 5, "text": "కర్పూర నీరాజనం సమర్పయామి ॥", "startMs": 12892, "endMs": 15344}]