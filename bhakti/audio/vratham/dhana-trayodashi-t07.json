[{"i": 0, "text": "ఓం నమో భగవతే ధన్వంతరయే ।", "startMs": 87, "endMs": 2944}, {"i": 1, "text": "అమృతకలశహస్తాయ ।", "startMs": 2944, "endMs": 4594}, {"i": 2, "text": "సర్వామయవినాశనాయ ।", "startMs": 4594, "endMs": 6423}, {"i": 3, "text": "త్రైలోక్యనాథాయ శ్రీమహావిష్ణవే నమః ॥", "startMs": 6423, "endMs": 8694}]