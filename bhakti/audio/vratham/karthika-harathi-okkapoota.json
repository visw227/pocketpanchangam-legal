[{"i": 0, "text": "శివాయ విష్ణురూపాయ", "startMs": 0, "endMs": 1500}, {"i": 1, "text": "శివరూపాయ విష్ణవే ।", "startMs": 1520, "endMs": 3081}, {"i": 2, "text": "శివస్య హృదయం విష్ణుః", "startMs": 3442, "endMs": 4830}, {"i": 3, "text": "విష్ణోశ్చ హృదయం శివః ॥", "startMs": 4850, "endMs": 7073}, {"i": 4, "text": "ఓం శ్రీ శివకేశవాభ్యాం నమః ।", "startMs": 7603, "endMs": 10176}, {"i": 5, "text": "కర్పూర నీరాజనం సమర్పయామి ॥", "startMs": 10578, "endMs": 13036}]