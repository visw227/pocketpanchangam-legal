[{"i": 0, "text": "\u0c36\u0c3e\u0c02\u0c24\u0c3e\u0c15\u0c3e\u0c30\u0c02 \u0c2d\u0c41\u0c1c\u0c17\u0c36\u0c2f\u0c28\u0c02 \u0c2a\u0c26\u0c4d\u0c2e\u0c28\u0c3e\u0c2d\u0c02 \u0c38\u0c41\u0c30\u0c47\u0c36\u0c02 \u0964", "startMs": 121, "endMs": 3296}, {"i": 1, "text": "\u0c35\u0c3f\u0c36\u0c4d\u0c35\u0c3e\u0c27\u0c3e\u0c30\u0c02 \u0c17\u0c17\u0c28\u0c38\u0c26\u0c43\u0c36\u0c02 \u0c2e\u0c47\u0c18\u0c35\u0c30\u0c4d\u0c23\u0c02 \u0c36\u0c41\u0c2d\u0c3e\u0c02\u0c17\u0c2e\u0c4d \u0965", "startMs": 3803, "endMs": 6818}, {"i": 2, "text": "\u0c32\u0c15\u0c4d\u0c37\u0c4d\u0c2e\u0c40\u0c15\u0c3e\u0c02\u0c24\u0c02 \u0c15\u0c2e\u0c32\u0c28\u0c2f\u0c28\u0c02 \u0c2f\u0c4b\u0c17\u0c3f\u0c39\u0c43\u0c26\u0c4d\u0c27\u0c4d\u0c2f\u0c3e\u0c28\u0c17\u0c2e\u0c4d\u0c2f\u0c02 \u0964", "startMs": 7276, "endMs": 10449}, {"i": 3, "text": "\u0c35\u0c02\u0c26\u0c47 \u0c35\u0c3f\u0c37\u0c4d\u0c23\u0c41\u0c02 \u0c2d\u0c35\u0c2d\u0c2f\u0c39\u0c30\u0c02 \u0c38\u0c30\u0c4d\u0c35\u0c32\u0c4b\u0c15\u0c48\u0c15\u0c28\u0c3e\u0c25\u0c2e\u0c4d \u0965", "startMs": 10866, "endMs": 13796}]