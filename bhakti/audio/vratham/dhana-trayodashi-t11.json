[{"i": 0, "text": "కాయేన వాచా మనసేంద్రియైర్వా", "startMs": 0, "endMs": 2545}, {"i": 1, "text": "బుద్ధ్యాత్మనా వా ప్రకృతేః స్వభావాత్ ।", "startMs": 2545, "endMs": 5361}, {"i": 2, "text": "కరోమి యద్యత్ సకలం పరస్మై", "startMs": 5361, "endMs": 7469}, {"i": 3, "text": "నారాయణాయేతి సమర్పయామి ॥", "startMs": 7469, "endMs": 8889}]