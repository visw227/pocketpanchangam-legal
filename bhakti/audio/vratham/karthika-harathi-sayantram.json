[{"i": 0, "text": "\u0c2e\u0c02\u0c17\u0c33\u0c02 \u0c2d\u0c17\u0c35\u0c3e\u0c28\u0c4d \u0c35\u0c3f\u0c37\u0c4d\u0c23\u0c41\u0c03", "startMs": 90, "endMs": 1791}, {"i": 1, "text": "\u0c2e\u0c02\u0c17\u0c33\u0c02 \u0c17\u0c30\u0c41\u0c21\u0c27\u0c4d\u0c35\u0c1c\u0c03 \u0964", "startMs": 2127, "endMs": 3375}, {"i": 2, "text": "\u0c2e\u0c02\u0c17\u0c33\u0c02 \u0c2a\u0c41\u0c02\u0c21\u0c30\u0c40\u0c15\u0c3e\u0c15\u0c4d\u0c37\u0c03", "startMs": 3703, "endMs": 5322}, {"i": 3, "text": "\u0c2e\u0c02\u0c17\u0c33\u0c3e\u0c2f \u0c24\u0c28\u0c4b \u0c39\u0c30\u0c3f\u0c03 \u0965", "startMs": 5663, "endMs": 7062}, {"i": 4, "text": "\u0c13\u0c02 \u0c36\u0c4d\u0c30\u0c40 \u0c36\u0c3f\u0c35\u0c15\u0c47\u0c36\u0c35\u0c3e\u0c2d\u0c4d\u0c2f\u0c3e\u0c02 \u0c28\u0c2e\u0c03 \u0964", "startMs": 7595, "endMs": 10140}, {"i": 5, "text": "\u0c15\u0c30\u0c4d\u0c2a\u0c42\u0c30 \u0c28\u0c40\u0c30\u0c3e\u0c1c\u0c28\u0c02 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c2f\u0c3e\u0c2e\u0c3f \u0965", "startMs": 10555, "endMs": 13008}]