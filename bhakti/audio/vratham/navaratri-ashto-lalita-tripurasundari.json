[{"i": 0, "text": "\u0c30\u0c1c\u0c24\u0c3e\u0c1a\u0c32\u0c36\u0c43\u0c02\u0c17\u0c3e\u0c17\u0c4d\u0c30\u0c2e\u0c27\u0c4d\u0c2f\u0c38\u0c4d\u0c25\u0c3e\u0c2f\u0c48 \u0c28\u0c2e\u0c4b \u0c28\u0c2e\u0c03", "startMs": 0, "endMs": 3046}, {"i": 1, "text": "\u0c39\u0c3f\u0c2e\u0c3e\u0c1a\u0c32\u0c2e\u0c39\u0c3e\u0c35\u0c02\u0c36\u0c2a\u0c3e\u0c35\u0c28\u0c3e\u0c2f\u0c48 \u0c28\u0c2e\u0c4b \u0c28\u0c2e\u0c03", "startMs": 3412, "endMs": 5779}, {"i": 2, "text": "\u0c36\u0c02\u0c15\u0c30\u0c3e\u0c30\u0c4d\u0c27\u0c3e\u0c02\u0c17\u0c38\u0c4c\u0c02\u0c26\u0c30\u0c4d\u0c2f\u0c36\u0c30\u0c40\u0c30\u0c3e\u0c2f\u0c48 \u0c28\u0c2e\u0c4b \u0c28\u0c2e\u0c03", "startMs": 6027, "endMs": 9087}, {"i": 3, "text": "\u0c32\u0c38\u0c28\u0c4d\u0c2e\u0c30\u0c15\u0c24\u0c38\u0c4d\u0c35\u0c1a\u0c4d\u0c1b\u0c35\u0c3f\u0c17\u0c4d\u0c30\u0c39\u0c3e\u0c2f\u0c48 \u0c28\u0c2e\u0c4b \u0c28\u0c2e\u0c03", "startMs": 9399, "endMs": 11852}, {"i": 4, "text": "\u0c2e\u0c39\u0c3e\u0c24\u0c3f\u0c36\u0c2f\u0c38\u0c4c\u0c02\u0c26\u0c30\u0c4d\u0c2f\u0c32\u0c3e\u0c35\u0c23\u0c4d\u0c2f\u0c3e\u0c2f\u0c48 \u0c28\u0c2e\u0c4b \u0c28\u0c2e\u0c03", "startMs": 12163, "endMs": 14585}, {"i": 5, "text": "\u0c36\u0c36\u0c3e\u0c02\u0c15\u0c36\u0c47\u0c16\u0c30\u0c2a\u0c4d\u0c30\u0c3e\u0c23\u0c35\u0c32\u0c4d\u0c32\u0c2d\u0c3e\u0c2f\u0c48 \u0c28\u0c2e\u0c4b \u0c28\u0c2e\u0c03", "startMs": 14869, "endMs": 17405}, {"i": 6, "text": "\u0c38\u0c26\u0c3e\u0c2a\u0c02\u0c1a\u0c26\u0c36\u0c3e\u0c24\u0c4d\u0c2e\u0c48\u0c15\u0c4d\u0c2f\u0c38\u0c4d\u0c35\u0c30\u0c42\u0c2a\u0c3e\u0c2f\u0c48 \u0c28\u0c2e\u0c4b \u0c28\u0c2e\u0c03", "startMs": 17603, "endMs": 20807}, {"i": 7, "text": "\u0c35\u0c1c\u0c4d\u0c30\u0c2e\u0c3e\u0c23\u0c3f\u0c15\u0c4d\u0c2f\u0c15\u0c1f\u0c15\u0c15\u0c3f\u0c30\u0c40\u0c1f\u0c3e\u0c2f\u0c48 \u0c28\u0c2e\u0c4b \u0c28\u0c2e\u0c03", "startMs": 21098, "endMs": 23764}, {"i": 8, "text": "\u0c15\u0c38\u0c4d\u0c24\u0c42\u0c30\u0c40\u0c24\u0c3f\u0c32\u0c15\u0c4b\u0c32\u0c4d\u0c32\u0c3e\u0c38\u0c3f\u0c28\u0c3f\u0c1f\u0c3f\u0c32\u0