[{"i": 0, "text": "నాగేంద్రహారాయ త్రిలోచనాయ", "startMs": 82, "endMs": 1960}, {"i": 1, "text": "భస్మాంగరాగాయ మహేశ్వరాయ ।", "startMs": 2023, "endMs": 3417}, {"i": 2, "text": "నిత్యాయ శుద్ధాయ దిగంబరాయ", "startMs": 3890, "endMs": 5520}, {"i": 3, "text": "తస్మై నకారాయ నమః శివాయ ॥", "startMs": 5560, "endMs": 7010}]