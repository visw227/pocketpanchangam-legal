[{"i":0,"text":"Is to remain…","startMs":2910,"endMs":3606},{"i":1,"text":"A learner.","startMs":4026,"endMs":4602},{"i":2,"text":"The day we believe… “I already know enough.”","startMs":5282,"endMs":7634},{"i":3,"text":"Is the day… We stop growing.","startMs":8054,"endMs":9710},{"i":4,"text":"But when we stay curious…","startMs":10390,"endMs":11854},{"i":5,"text":"Every experience becomes a lesson.","startMs":12274,"endMs":13858},{"i":6,"text":"Every person…","startMs":14538,"endMs":15306},{"i":7,"text":"Becomes a teacher.","startMs":15726,"endMs":16614},{"i":8,"text":"Even… A tree.","startMs":17294,"endMs":18110},{"i":9,"text":"An ant.","startMs":18330,"endMs":18834},{"i":10,"text":"A flowing river.","startMs":19054,"endMs":19822},{"i":11,"text":"Or a child.","startMs":20042,"endMs":20810},{"i":12,"text":"Because…","startMs":21490,"endMs":22066},{"i":13,"text":"To a true learner…","startMs":22486,"endMs":23446},{"i":14,"text":"The entire universe becomes a Guru.","startMs":23866,"endMs":25522},{"i":15,"text":"🙏 Happy Guru Purnima","startMs":26202,"endMs":27282}]