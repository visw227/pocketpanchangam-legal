[{"i":0,"text":"Is to remain…","startMs":2790,"endMs":3750},{"i":1,"text":"A learner.","startMs":4170,"endMs":4746},{"i":2,"text":"The day we believe… “I already know enough.”","startMs":5426,"endMs":7730},{"i":3,"text":"Is the day… We stop growing.","startMs":8150,"endMs":9926},{"i":4,"text":"But when we stay curious…","startMs":10606,"endMs":11950},{"i":5,"text":"Every experience becomes a lesson.","startMs":12370,"endMs":14098},{"i":6,"text":"Every person…","startMs":14778,"endMs":15594},{"i":7,"text":"Becomes a teacher.","startMs":16014,"endMs":16902},{"i":8,"text":"Even… A tree.","startMs":17582,"endMs":18662},{"i":9,"text":"An ant.","startMs":18882,"endMs":19578},{"i":10,"text":"A flowing river.","startMs":19798,"endMs":20686},{"i":11,"text":"Or a child.","startMs":20906,"endMs":21602},{"i":12,"text":"Because…","startMs":22282,"endMs":22786},{"i":13,"text":"To a true learner…","startMs":23206,"endMs":24094},{"i":14,"text":"The entire universe becomes a Guru.","startMs":24514,"endMs":26170},{"i":15,"text":"🙏 Happy Guru Purnima","startMs":26850,"endMs":27858}]