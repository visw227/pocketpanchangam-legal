[{"i":0,"text":"Offer gandham, turmeric, kumkuma, akshatalu and flowers to Ammavaru.","startMs":2214,"endMs":6438},{"i":1,"text":"If you have a picture, offer them on a small plate in front of the picture.","startMs":6658,"endMs":10306},{"i":2,"text":"Om Sri Mahalakshmyai Namaha ।","startMs":10526,"endMs":12494},{"i":3,"text":"Gandham Samarpayami ।","startMs":12714,"endMs":14058},{"i":4,"text":"Om Sri Mahalakshmyai Namaha ।","startMs":14278,"endMs":16006},{"i":5,"text":"Pushpani Samarpayami ॥","startMs":16226,"endMs":17498}]