[{"i":0,"text":"Place the naivedyam you have prepared, the fruits, the coconut and water in front of Ammavaru.","startMs":2286,"endMs":7014},{"i":1,"text":"Om Sri Mahalakshmyai Namaha ।","startMs":7234,"endMs":8818},{"i":2,"text":"Naivedyam Nivedayami ॥","startMs":9038,"endMs":10622},{"i":3,"text":"Then offer betel leaves and betel nuts.","startMs":10842,"endMs":12810},{"i":4,"text":"Om Sri Mahalakshmyai Namaha ।","startMs":13030,"endMs":14998},{"i":5,"text":"Tambulam Samarpayami ॥","startMs":15218,"endMs":16418}]