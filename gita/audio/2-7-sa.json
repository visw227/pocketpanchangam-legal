[{"i": 0, "text": "kārpaṇya-doṣopahata-svabhāvaḥ", "startMs": 0, "endMs": 4744}, {"i": 1, "text": "pṛichchhāmi tvāṁ dharma-sammūḍha-chetāḥ", "startMs": 4744, "endMs": 11123}, {"i": 2, "text": "yach-chhreyaḥ syānniśchitaṁ brūhi tanme", "startMs": 11123, "endMs": 17502}, {"i": 3, "text": "śiṣyaste ’haṁ śādhi māṁ tvāṁ prapannam", "startMs": 17502, "endMs": 23720}]