[{"i": 0, "text": "atha vyavasthitān dṛiṣṭvā dhārtarāṣṭrān kapi-dhwajaḥ", "startMs": 0, "endMs": 5690}, {"i": 1, "text": "pravṛitte śastra-sampāte dhanurudyamya pāṇḍavaḥ", "startMs": 5690, "endMs": 10833}, {"i": 2, "text": "hṛiṣīkeśaṁ tadā vākyam idam āha mahī-pate", "startMs": 10833, "endMs": 15320}]